<ui version="4.0">
 <class>ProjectsTab</class>
 <widget class="QWidget" name="ProjectsTab">
  <layout class="QHBoxLayout" name="mainLayout">
   <item>
    <widget class="QGroupBox" name="grp_list">
     <property name="title"><string>Projects</string></property>
     <property name="maximumWidth"><number>300</number></property>
     <layout class="QVBoxLayout" name="listLayout">
      <item>
       <layout class="QHBoxLayout" name="filterLayout">
