<?xml version="1.0" encoding="UTF-8"?>
<!--
  The transit reduction block (EXOTIC) of the photometric series (2026-10-06).
  It used to live in the visit panel of the editor's left column; it belongs
  to the SERIES: EXOTIC reduces and fits the transit light curve, which is
  what that series is. Loaded by gui/ufe_dialog.py through gui/ui_loader.py
  and shown inside the series window (Tools -> Series). The class tag is
  UfeDialog so the i18n context carries over from where it was before.
-->
<ui version="4.0">
 <class>UfeDialog</class>
 <widget class="QWidget" name="UfeExoticBlock">
  <layout class="QVBoxLayout" name="vbox_exotic_block">
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <item>
    <widget class="QGroupBox" name="grp_exotic">
     <property name="title"><string>Transit reduction (EXOTIC)</string></property>
     <property name="visible"><bool>false</bool></property>
     <layout class="QVBoxLayout" name="vbox_exotic">
      <item><widget class="QPushButton" name="btn_exotic_reduce"><property name="text"><string>Reduce and fit with EXOTIC…</string></property><property name="toolTip"><string>Generate the visit's inits.json, run EXOTIC headless and import its light curve and fitted parameters. Uses the open frame as the reference and the comparison sequence of this series</string></property></widget></item>
      <item><widget class="QPushButton" name="btn_exotic_export"><property name="text"><string>Export to EXOTIC (inits.json)…</string></property><property name="toolTip"><string>Pre-filled EXOTIC initialization file: planet, observatory, camera and filter</string></property></widget></item>
      <item><widget class="QLabel" name="lbl_exotic_result"><property name="text"><string/></property><property name="wordWrap"><bool>true</bool></property><property name="toolTip"><string>The last reduction of this visit: its transit time and radius ratio. «See the result» opens the numbers, the light curve and every file it wrote</string></property></widget></item>
      <item>
       <layout class="QHBoxLayout" name="row_exotic_result">
        <item><widget class="QPushButton" name="btn_exotic_result"><property name="text"><string>See the result…</string></property><property name="toolTip"><string>The fitted parameters, the light curve EXOTIC drew and every file the reduction wrote (field figures, diagnostics, the AAVSO report), each one a double click from the system</string></property><property name="enabled"><bool>false</bool></property></widget></item>
        <item><widget class="QPushButton" name="btn_exotic_folder"><property name="text"><string>Open the folder</string></property><property name="toolTip"><string>Open the project's EXOTIC work folder with the file manager</string></property><property name="enabled"><bool>false</bool></property></widget></item>
       </layout>
      </item>
      <item><widget class="QLabel" name="lbl_exotic_status"><property name="text"><string/></property><property name="wordWrap"><bool>true</bool></property></widget></item>
     </layout>
    </widget>
   </item>
   <item><spacer name="vsp_exotic_block"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property></spacer></item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
