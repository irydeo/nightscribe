<?xml version="1.0" encoding="UTF-8"?>
<!--
  UFE Measure tab: the manual centre control in its own small non-modal
  window (ADR-044 rev). The Measure tab keeps only the checkbox and shows
  this dialog while it is checked; the tab owns the behaviour (it wires
  the arrows and moves the measurement centre). Loaded by
  gui/ufe_centre_dialog.py through gui/ui_loader.py; the class tag matches
  the Python class so the i18n context carries over. The readout is data:
  code sets it.
-->
<ui version="4.0">
 <class>UfeCentreDialog</class>
 <widget class="QWidget" name="UfeCentreDialog">
  <layout class="QVBoxLayout" name="vbox_centre">
   <property name="leftMargin"><number>11</number></property>
   <property name="topMargin"><number>11</number></property>
   <property name="rightMargin"><number>11</number></property>
   <property name="bottomMargin"><number>11</number></property>
   <item>
    <widget class="QLabel" name="lbl_centre_hint">
     <property name="text">
      <string>Move the measurement centre by hand: the measurement uses exactly this point, with no centroid search, so a very faint SN cannot be dragged to a neighbour.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="row_centre">
     <item>
      <layout class="QGridLayout" name="grid_nudge">
       <item row="0" column="1"><widget class="QPushButton" name="btn_up"><property name="text"><string>↑</string></property><property name="toolTip"><string>Move the centre up 0.1 px</string></property></widget></item>
       <item row="1" column="0"><widget class="QPushButton" name="btn_left"><property name="text"><string>←</string></property><property name="toolTip"><string>Move the centre left 0.1 px</string></property></widget></item>
       <item row="1" column="1"><widget class="QLabel" name="lbl_nudge"><property name="text"><string/></property><property name="alignment"><set>Qt::AlignCenter</set></property><property name="minimumSize"><size><width>80</width><height>0</height></size></property></widget></item>
       <item row="1" column="2"><widget class="QPushButton" name="btn_right"><property name="text"><string>→</string></property><property name="toolTip"><string>Move the centre right 0.1 px</string></property></widget></item>
       <item row="2" column="1"><widget class="QPushButton" name="btn_down"><property name="text"><string>↓</string></property><property name="toolTip"><string>Move the centre down 0.1 px</string></property></widget></item>
      </layout>
     </item>
     <item>
      <widget class="QPushButton" name="btn_nudge_reset">
       <property name="text">
        <string>0</string>
       </property>
       <property name="toolTip">
        <string>Back to the clicked centre</string>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="hsp_centre">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
