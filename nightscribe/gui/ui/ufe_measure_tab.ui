    <item>
     <layout class="QHBoxLayout" name="row_nudge">
      <item>
       <widget class="QCheckBox" name="chk_manual_centre">
        <property name="text">
         <string>Manual centre (no centroid)</string>
        </property>
        <property name="toolTip">
         <string>Checking it opens a small window with the arrows: the measurement then uses EXACTLY the centre you place (no centroid search at all), so a very faint SN or a galaxy core cannot drag it. Unchecking closes it and the centroid refines the click again</string>
        </property>
       </widget>
