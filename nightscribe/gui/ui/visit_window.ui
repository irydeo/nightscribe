<?xml version="1.0" encoding="UTF-8"?>
<!--
  Visit window (ADR-045, form A): the visit's non-modal work window.
  Loaded by gui/widgets/visits_panel.py through gui/ui_loader.py.
  The Measurements and Astrometry blocks are per-kind fragments
  (ui/visit_measurements.ui, ui/visit_mpc_block.ui) loaded only when the
  project's kind calls for them: absent means absent, as the pinned
  tests demand. The PassiveList / PassiveDoubleSpinBox wheel guards are
  custom widgets inserted into the placeholders in code (ADR-005).
-->
