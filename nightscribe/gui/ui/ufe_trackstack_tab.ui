 <class>UfeTrackStackTab</class>
 <widget class="QWidget" name="UfeTrackStackTab">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>406</width>
    <height>700</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="vbox_trackstack">
   <property name="leftMargin"><number>9</number></property>
   <property name="topMargin"><number>9</number></property>
   <property name="rightMargin"><number>9</number></property>
   <property name="bottomMargin"><number>9</number></property>
   <item>
    <layout class="QHBoxLayout" name="row_head">
     <item>
      <widget class="QLabel" name="lbl_object">
       <property name="text">
        <string>Object and frames: open the editor from a visit to arm the sequence.</string>
       </property>
       <property name="toolTip">
        <string>The object comes from the project and the frames from the visit. The rate and the position angle come from Horizons when the run starts, and its notes say what it measured</string>
       </property>
       <property name="wordWrap"><bool>true</bool></property>
      </widget>
     </item>
     <item>
      <widget class="QToolButton" name="btn_more">
       <property name="minimumSize"><size><width>32</width><height>26</height></size></property>
       <property name="font"><font><pointsize>14</pointsize></font></property>
       <property name="text"><string>⋯</string></property>
       <property name="popupMode"><enum>QToolButton::InstantPopup</enum></property>
       <property name="toolTip">
        <string>The occasional actions, so they do not eat the panel: the blink figure of the observations, and undoing this run</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QPushButton" name="btn_stack">
     <property name="enabled"><bool>false</bool></property>
     <property name="minimumSize"><size><width>0</width><height>48</height></size></property>
     <property name="text"><string>Stack the sequence</string></property>
     <property name="toolTip">
      <string>Run the whole pipeline: solve the reference, register the frames, stack, detect, sweep the velocity, stack each observation, measure and check. While it runs, this button is the Cancel</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="lbl_plan_line">
     <property name="text"><string/></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <widget class="QProgressBar" name="prg_stack">
     <property name="visible"><bool>false</bool></property>
    </widget>
   </item>
   <item>
    <widget class="QPlainTextEdit" name="lbl_status">
     <property name="visible"><bool>false</bool></property>
     <property name="minimumSize"><size><width>0</width><height>34</height></size></property>
     <property name="maximumSize"><size><width>16777215</width><height>68</height></size></property>
     <property name="focusPolicy"><enum>Qt::NoFocus</enum></property>
     <property name="styleSheet"><string notr="true">background: transparent; border: none;</string></property>
     <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
     <property name="readOnly"><bool>true</bool></property>
     <property name="plainText"><string/></property>
     <property name="lineWrapMode"><enum>QPlainTextEdit::WidgetWidth</enum></property>
     <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="sec_plan_content" native="true">
     <layout class="QVBoxLayout" name="vbox_plan">
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>
    <item>
     <layout class="QHBoxLayout" name="row_nobs">
      <item>
       <widget class="QLabel" name="lbl_nobs">
        <property name="text"><string>Observations:</string></property>
       </widget>
      </item>
      <item>
       <widget class="QSpinBox" name="spn_nobs">
        <property name="enabled"><bool>false</bool></property>
        <property name="minimum"><number>1</number></property>
        <property name="maximum"><number>999</number></property>
        <property name="toolTip">
         <string>How many observations the sequence is split into: contiguous groups of frames, each with its own middle-of-exposure instant. The SNR grows with the square root of the frames, so asking for more observations splits the signal, and the line beside this one shows what each would reach</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lbl_snr_line">
        <property name="text"><string/></property>
        <property name="toolTip">
         <string>The SNR each observation is expected to reach, from the frames it gets: the SNR grows with the square root of the frames, so asking for more observations splits the signal. The full table is below, in its own fold</string>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="hsp_nobs">
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
        <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
       </spacer>
      </item>
     </layout>
    </item>
    <item>
     <widget class="QWidget" name="sec_snr_content" native="true">
      <layout class="QVBoxLayout" name="vbox_snr">
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>
       <item>
        <widget class="QTableWidget" name="tbl_snr">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Maximum">
           <horstretch>0</horstretch>
           <verstretch>0</verstretch>
          </sizepolicy>
         </property>
         <property name="maximumSize"><size><width>16777215</width><height>120</height></size></property>
         <property name="toolTip">
          <string>One row per observation: its frames, its middle-of-exposure instant (UTC) and the SNR it is expected to reach. A group below the submission floor set in Settings is left out of the report, with its reason</string>
         </property>
         <column><property name="text"><string>Obs.</string></property></column>
         <column><property name="text"><string>Frames</string></property></column>
         <column><property name="text"><string>T_mid (UT)</string></property></column>
         <column><property name="text"><string>Expected SNR</string></property></column>
        </widget>
       </item>
      </layout>
     </widget>
    </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="sec_advanced_content" native="true">
     <layout class="QVBoxLayout" name="vbox_advanced">
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>
      <item>
       <layout class="QHBoxLayout" name="row_method">
        <item>
         <widget class="QLabel" name="lbl_method">
          <property name="text"><string>Method:</string></property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="cmb_method">
          <property name="sizeAdjustPolicy"><enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum></property>
          <property name="minimumContentsLength"><number>10</number></property>
          <property name="toolTip">
           <string>How the frames of each group are combined, and what it costs. Measured by injecting sources of a known brightness into real frames and measuring them back: the sigma-clipped mean (the default) goes deeper than the median by about a quarter of a magnitude, because a median is 1.25x noisier than a mean; the plain mean is as deep as the clip but keeps the star trails, which are what the clip is for. Weighted is the same clip with each frame counting by 1/sigma^2 of its own sky: it changes nothing on a stable night and it is what saves a night with thin cloud or moon. Sum and mean differ only in scale. Use the median only when something must be rejected outright and the clip cannot.</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="row_warp">
        <item>
         <widget class="QLabel" name="lbl_warp">
          <property name="text"><string>Resampling:</string></property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="cmb_warp_order">
          <property name="sizeAdjustPolicy"><enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum></property>
          <property name="minimumContentsLength"><number>10</number></property>
          <property name="toolTip">
           <string>How the frames are resampled onto the output grid. The bilinear (the default) makes the image visibly cleaner at NO cost in depth, and that is measured, not assumed: injecting sources of a known brightness into real frames and measuring them back, the interpolation orders tie in depth while the pixel noise differs noticeably. A smoother image is not a deeper one: the depth is decided by the combination above and by the frames that go in, and the pixel noise of a smoothed stack is not a measure of how faint it reaches. The cubic keeps a marginally sharper point spread and a grainier image: use it if you are chasing detail in a crowded field.</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="row_field">
        <item>
         <widget class="QLabel" name="lbl_final_field"><property name="text"><string>Field:</string></property></widget>
        </item>
        <item>
         <widget class="QComboBox" name="cmb_final_size">
          <property name="sizeAdjustPolicy"><enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum></property>
          <property name="minimumContentsLength"><number>10</number></property>
          <property name="toolTip">
           <string>How much sky the FINAL stack of each observation covers. The whole frame is the field with the comparison stars around it; a smaller window is faster and lighter. The velocity sweep always works on the object's own trail cutout, whatever this says.</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="hsp_field">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="row_margin">
        <item>
         <widget class="QLabel" name="lbl_margin"><property name="text"><string>Margin:</string></property></widget>
        </item>
        <item>
         <widget class="QSpinBox" name="spn_margin">
          <property name="minimum"><number>8</number></property>
          <property name="maximum"><number>1024</number></property>
          <property name="value"><number>64</number></property>
          <property name="suffix"><string> px</string></property>
          <property name="toolTip">
           <string>Extra pixels around the object's own trail in the cutout the detection and the velocity sweep use. Bigger is safer and slower; the final stack does not use it.</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="hsp_margin">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="row_brightness">
        <item>
         <widget class="QCheckBox" name="chk_brightness">
          <property name="checked"><bool>true</bool></property>
          <property name="text"><string>Measure the brightness</string></property>
          <property name="toolTip">
           <string>Measures each observation's magnitude: the object on its own stack and the comparison stars on small stacks of the same frames aligned on the stars, because on the object's stack they are streaks. Without it the run reports positions only and says so</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="hsp_brightness">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="row_calibrate">
        <item>
         <widget class="QCheckBox" name="chk_calibrate">
          <property name="text"><string>Apply the calibration</string></property>
          <property name="toolTip">
           <string>Applies the calibration recipe (the masters of the Calibration tab: dark/bias and flat) to each frame as it is read, so the stacking never needs calibrated copies on disk. A stack of uncalibrated frames keeps the train's dust and the sensor's vignetting, and the object and the comparisons do not sit in the same place: the smooth vignetting alone is worth a systematic error of a tenth of a magnitude. When the library has no flat for this filter, a flat is built from the frames themselves, with no star in it, and with the same dark/bias removed as the light so the pedestal does not compress it (the run says what it did); a real flat always wins. The recipe, the library and the pseudo-flat policy live in the Calibration tab</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btn_calibration">
          <property name="text"><string>Calibration…</string></property>
          <property name="toolTip">
           <string>Opens the Calibration tab: the master library, the resolved recipe and the pseudo-flat policy that this checkbox applies</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="hsp_calibrate">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QLabel" name="lbl_calibration_hint">
        <property name="text"><string/></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="row_starstack">
        <item>
         <widget class="QCheckBox" name="chk_starstack">
          <property name="text"><string>Keep the star stack</string></property>
          <property name="toolTip">
           <string>Saves a second stack of the same frames, aligned on the STARS, next to each observation's stack. It costs one more stacking pass and it is what the Photometry tab needs to measure the brightness by hand (there the object's stack has its stars as trails). The run measures with it too, so nothing is built twice</string>
          </property>
         </widget>
        </item>
        <item>
         <spacer name="hsp_starstack">
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
          <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
         </spacer>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="row_recipe">
        <item>
         <widget class="QLabel" name="lbl_recipe">
          <property name="text"><string/></property>
          <property name="wordWrap"><bool>true</bool></property>
          <property name="toolTip">
           <string>The recipe the brightness is measured with, read live from the Photometry tab: the apertures, the sky method, the centroid and the colour term. One editor in the app, so the numbers cannot drift apart</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btn_recipe">
          <property name="text"><string>Photometry settings…</string></property>
          <property name="toolTip">
           <string>The apertures, the sky method and the centroid the run will use are edited in the Photometry tab, and nowhere else. The brightness itself is measured here, on the stacks</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="sec_notes_content" native="true">
     <layout class="QVBoxLayout" name="vbox_notes">
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>
    <item>
     <widget class="QPlainTextEdit" name="txt_notes">
      <property name="visible"><bool>false</bool></property>
      <property name="minimumSize"><size><width>0</width><height>90</height></size></property>
      <property name="maximumSize"><size><width>16777215</width><height>170</height></size></property>
      <property name="readOnly"><bool>true</bool></property>
      <property name="toolTip">
       <string>What the run found: the dithering, the composed WCS quality, the velocity sweep, the detection and the brightness. The box keeps its own height and scrolls, so a long night never pushes the rest out of the panel and nothing is cut</string>
      </property>
     </widget>
    </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="sec_view_content" native="true">
     <layout class="QVBoxLayout" name="vbox_view">
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>
    <item>
     <layout class="QHBoxLayout" name="row_view">
      <item>
       <widget class="QLabel" name="lbl_view">
        <property name="text"><string>Observation:</string></property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="cmb_group">
        <property name="enabled"><bool>false</bool></property>
        <property name="toolTip">
         <string>Which observation's stack is shown below, with the measured position marked</string>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="hsp_view">
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
        <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
       </spacer>
      </item>
     </layout>
    </item>
    <item>
     <layout class="QHBoxLayout" name="row_obsactions">
      <item>
       <widget class="QPushButton" name="btn_blink">
        <property name="enabled"><bool>false</bool></property>
        <property name="text"><string>Blink / montage…</string></property>
        <property name="toolTip">
         <string>Writes one figure with every observation's stack centred on the object, all with the SAME stretch: a GIF that blinks, or a still montage. Auto-stretching each panel separately would make a faint one look as bright as a real one</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btn_animate">
        <property name="enabled"><bool>false</bool></property>
        <property name="checkable"><bool>true</bool></property>
        <property name="text"><string>Animate / verify</string></property>
        <property name="toolTip">
         <string>Plays the observation stacks here, in the main view, centred on the object and with ONE shared stretch: the object must stay put in the middle while the stars crawl, which is what says the detection is real. It writes nothing and asks for no viewer. Click again to stop</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btn_export_anim">
        <property name="enabled"><bool>false</bool></property>
        <property name="text"><string>Save animation…</string></property>
        <property name="toolTip">
         <string>Saves the animation as a GIF or an MP4 with the levels you applied and the plate's heading on every frame: the same thing the loop shows, so it can be shared as the proof of the detection. The format follows the file name you choose</string>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="hsp_obsactions">
        <property name="orientation"><enum>Qt::Horizontal</enum></property>
        <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
       </spacer>
      </item>
     </layout>
    </item>
    <item>
     <widget class="QWidget" name="ph_thumbs" native="true">
      <property name="minimumSize"><size><width>0</width><height>86</height></size></property>
      <property name="toolTip">
       <string>Every observation's stack, centred on the object. Click one to bring it to the main view</string>
      </property>
     </widget>
    </item>
    <item>
     <widget class="QWidget" name="ph_stack_view" native="true">
      <property name="minimumSize"><size><width>0</width><height>220</height></size></property>
     </widget>
    </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="sec_points_content" native="true">
     <layout class="QVBoxLayout" name="vbox_points">
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>
    <item>
     <widget class="QLabel" name="lbl_points_title">
      <property name="visible"><bool>false</bool></property>
      <property name="text"><string>Measurement per observation</string></property>
      <property name="toolTip">
       <string>The position is measured twice with the same centroid recipe: on the stack and per frame. A disagreement beyond 0.5 arcsec or 3 sigma is flagged, never resolved silently</string>
      </property>
     </widget>
    </item>
    <item>
     <widget class="QTableWidget" name="tbl_points">
      <property name="visible"><bool>false</bool></property>
      <property name="sizePolicy">
       <sizepolicy hsizetype="Expanding" vsizetype="Maximum">
        <horstretch>0</horstretch>
        <verstretch>0</verstretch>
       </sizepolicy>
      </property>
      <property name="maximumSize"><size><width>16777215</width><height>150</height></size></property>
      <column><property name="text"><string>Obs.</string></property></column>
      <column><property name="text"><string>T_mid</string></property></column>
      <column><property name="text"><string>RA</string></property></column>
      <column><property name="text"><string>Dec</string></property></column>
      <column><property name="text"><string>Δ″</string></property></column>
      <column><property name="text"><string>SNR</string></property></column>
      <column><property name="text"><string>Mag</string></property></column>
      <column><property name="text"><string>!</string></property></column>
     </widget>
    </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="chk_manual">
     <property name="enabled"><bool>false</bool></property>
     <property name="text"><string>Manual mode (faint object)…</string></property>
     <property name="toolTip">
      <string>Mark the object by hand on the whole-sequence stack and measure from your mark: the position is yours (snapped to the centroid, nudged in 0.1 px steps), the velocity is the ephemeris' and the sweep is not run. Useful for an object below the detection gate, and to place a detected one's centroid by eye. Needs a visit with frames</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="sec_check_content" native="true">
     <layout class="QVBoxLayout" name="vbox_check">
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>
      <item>
       <widget class="QPlainTextEdit" name="txt_check">
        <property name="minimumSize"><size><width>0</width><height>70</height></size></property>
        <property name="maximumSize"><size><width>16777215</width><height>130</height></size></property>
        <property name="readOnly"><bool>true</bool></property>
        <property name="plainText"><string>The verdict of the check appears here after a run: whether our point fits the published observations or stands out from them.</string></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="lbl_check_hint">
        <property name="text"><string>The check filters, it does not prove: fitting a short arc is not proof of a detection.</string></property>
        <property name="wordWrap"><bool>true</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="chk_force">
        <property name="enabled"><bool>false</bool></property>
        <property name="text"><string>Force the report</string></property>
        <property name="toolTip">
         <string>An outlier blocks the report by default; forcing it leaves the decision on record (the check's verdict and the report's own note say it was forced)</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QWidget" name="grp_report" native="true">
     <layout class="QVBoxLayout" name="vbox_report">
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>
      <item>
       <layout class="QHBoxLayout" name="row_format">
        <item>
         <widget class="QLabel" name="lbl_format">
          <property name="text"><string>Format:</string></property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="cmb_format">
          <property name="toolTip">
           <string>ADES PSV is the modern machine-readable format the MPC prefers; the 80-column format is the classic one, readable by every program</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="row_report">
        <item>
         <widget class="QPushButton" name="btn_report">
          <property name="enabled"><bool>false</bool></property>
          <property name="text"><string>Generate</string></property>
          <property name="toolTip">
           <string>Generate the report with the middle-of-exposure instants, the propagated uncertainties and the magnitude only when there are comparison stars; every observation below the submission floor is left out with its reason</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btn_send_mpc">
          <property name="enabled"><bool>false</bool></property>
          <property name="text"><string>Send to the MPC block</string></property>
          <property name="toolTip">
           <string>Fill the visit's MPC paste box with the report; the validator there has the last word before saving</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="btn_undo">
          <property name="enabled"><bool>false</bool></property>
          <property name="text"><string>Undo this run</string></property>
          <property name="toolTip">
           <string>Remove this execution's observations from the project (the run stays, marked undone, for the audit trail); the other runs and the visit are untouched</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QWidget" name="sec_report_content" native="true">
        <layout class="QVBoxLayout" name="vbox_report_text">
         <property name="leftMargin"><number>0</number></property>
         <property name="topMargin"><number>0</number></property>
         <property name="rightMargin"><number>0</number></property>
         <property name="bottomMargin"><number>0</number></property>
         <item>
          <widget class="QLabel" name="lbl_report_note">
           <property name="text"><string/></property>
           <property name="wordWrap"><bool>true</bool></property>
           <property name="toolTip">
            <string>What came out of the report: how many observations it carries and, when some were left out, why and where the submission floor is set. A report with no observations is not a report: the button that sends it stays disabled</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPlainTextEdit" name="txt_report">
           <property name="sizePolicy">
            <sizepolicy hsizetype="Expanding" vsizetype="Maximum">
             <horstretch>0</horstretch>
             <verstretch>0</verstretch>
            </sizepolicy>
           </property>
           <property name="minimumSize"><size><width>0</width><height>80</height></size></property>
           <property name="maximumSize"><size><width>16777215</width><height>140</height></size></property>
           <property name="readOnly"><bool>true</bool></property>
           <property name="font"><font><family>Monospace</family></font></property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <spacer name="vspacer_trackstack">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property>
    </spacer>
