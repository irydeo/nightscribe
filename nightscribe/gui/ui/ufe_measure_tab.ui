            <enum>Qt::Horizontal</enum>
           </property>
           <property name="sizeHint" stdset="0">
            <size>
             <width>10</width>
             <height>20</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </item>

      <item>
       <layout class="QHBoxLayout" name="row_series_doors">
        <item><widget class="QPushButton" name="btn_series_chart"><property name="toolTip"><string>How the curve is drawn (scale, error bars, binning, mean) and which points you leave out. Opens in its own window, so you can watch the curve while changing it</string></property><property name="text"><string>Chart…</string></property></widget></item>
        <item><widget class="QToolButton" name="btn_series_more"><property name="toolTip"><string>The occasional series actions: undo the last run, ExoClock, the night's figures, save the chart, period and phase, the guide</string></property><property name="text"><string>Series</string></property><property name="popupMode"><enum>QToolButton::InstantPopup</enum></property></widget></item>
        <item><spacer name="hsp_series_doors"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
       </layout>
      </item>
       <item>
        <layout class="QVBoxLayout" name="vbox_series_actions">
         <item>
          <layout class="QHBoxLayout" name="row_series_run">
           <item>
            <widget class="QPushButton" name="btn_series">
             <property name="toolTip">
              <string>Measure the frames of this visit as a series: per-frame zero point, quality flags, honest errors. A new run starts; "Undo this run" removes only its points</string>
             </property>
             <property name="text">
              <string>Measure the sequence</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btn_series_undo">
             <property name="enabled">
              <bool>false</bool>
             </property>
             <property name="toolTip">
              <string>Delete the points of the last series run of this visit, without touching any other run</string>
             </property>
             <property name="text">
              <string>Undo this run</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout" name="row_series_out">
           <item>
            <widget class="QPushButton" name="btn_series_passes">
             <property name="toolTip">
              <string>Every pass you measured on this visit, oldest first, with the one the chart is showing marked. Measuring again makes the new pass the curve; here you can go back to an earlier one WITHOUT deleting anything (the points of the others stay in the project), or undo a pass so its points go (the row stays, marked undone, and the chart falls back to the pass before it)</string>
             </property>
             <property name="text">
              <string>Passes of this visit…</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btn_series_exoclock">
             <property name="enabled">
              <bool>false</bool>
             </property>
             <property name="toolTip">
              <string>Prepare the ExoClock submission (three-column JD_UTC/flux file + ExoClock_info.txt), open the upload page and record the reported outcome</string>
             </property>
             <property name="text">
              <string>ExoClock…</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btn_series_night">
             <property name="toolTip">
              <string>Write the two figures that explain the night: the airmass of every point (a curve that fades and comes back is often the sky) and the position of the target (with the alignment on, this is the guide residual: the frame that jumped shows as a spike). Both are scientific figures, ready for the report</string>
             </property>
             <property name="text">
              <string>Night conditions (PNG)…</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btn_series_sci">
             <property name="toolTip">
              <string>Save the curve exactly as you see it, INTO THIS VISIT: the window you zoomed to, the points you selected or excluded, the fixed range if you set one. The chart joins the visit's resources, next to its frames and its reports</string>
             </property>
             <property name="text">
              <string>Save the chart in the visit (PNG)…</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btn_series_phase">
             <property name="toolTip">
              <string>Search the project's curve for its period (Lomb-Scargle and PDM) and fold it into the two-panel report, with what the baseline can and cannot say</string>
             </property>
             <property name="text">
              <string>Period and phase…</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btn_series_help">
             <property name="toolTip">
              <string>Open the sequences guide (SEQUENCES) in the documentation browser</string>
             </property>
             <property name="text">
              <string>?</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btn_series_discard">
             <property name="toolTip">
              <string>Undo every series run of this visit and start the curve from scratch: its points go and the runs stay marked as undone. The frames are never touched, so measuring again is one click</string>
             </property>
             <property name="text">
              <string>Discard this visit's curve…</string>
             </property>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </item>
      <item>
       <widget class="QCheckBox" name="chk_series_live">
        <property name="toolTip">
         <string>Live mode (opt-in): watch this visit's folder and measure each new frame as it lands, updating the curve every few frames. Off by default</string>
        </property>
        <property name="text">
         <string>Live (watch the folder)</string>
        </property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="row_series_scope">
        <item>
         <widget class="QLabel" name="lbl_series_scope">
          <property name="text">
           <string>Frames of:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QComboBox" name="cmb_series_scope">
          <property name="toolTip">
           <string>Which frames the series measures. THIS VISIT is the night you have open (the normal way). ALL THE VISITS measures every night of the project in ONE pass: each night's points are filed in its own visit, the whole pass is undone with one click, and the curve shows all the nights together (one pass per night). It needs a project with more than one visit with frames: with only one, this stays off and says why</string>
          </property>
          <property name="sizeAdjustPolicy">
           <enum>QComboBox::AdjustToMinimumContentsLengthWithIcon</enum>
          </property>
          <property name="minimumContentsLength">
           <number>12</number>
          </property>
          <property name="minimumSize">
           <size>
            <width>190</width>
            <height>0</height>
           </size>
          </property>
          <property name="sizePolicy">
           <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <item>
           <property name="text">
            <string>this visit</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>all visits</string>
           </property>
          </item>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="row_series_info">
        <item>
         <widget class="QLabel" name="lbl_series_frames">
          <property name="text">
           <string>Frames: 0</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lbl_series_cadence">
          <property name="text">
           <string>group 1 · cadence from the frames</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <widget class="QProgressBar" name="prg_series">
        <property name="value">
         <number>0</number>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
