<?xml version="1.0" encoding="UTF-8"?>
<!--
  UFE Astrometry tab: the published observations the Find_Orb check compares
  us with, in their own non-modal window (ADR-077). The check block keeps only
  the verdict and the button that opens this listing; the tab owns the
  behaviour (it fills the table and shows the window). Loaded by
  gui/ufe_published_obs_dialog.py through gui/ui_loader.py; the class tag
  matches the Python class so the i18n context carries over.
-->
<ui version="4.0">
 <class>UfePublishedObsDialog</class>
 <widget class="QWidget" name="UfePublishedObsDialog">
  <layout class="QVBoxLayout" name="vbox_residuals">
   <property name="leftMargin"><number>11</number></property>
   <property name="topMargin"><number>11</number></property>
   <property name="rightMargin"><number>11</number></property>
   <property name="bottomMargin"><number>11</number></property>
   <item>
    <widget class="QLabel" name="lbl_residuals_hint">
     <property name="text">
      <string>These are the observations other stations have already published that Find_Orb fitted the orbit to, with ours among them and highlighted. Each row carries the instant, the station, the direction and the residual in right ascension and declination. A residual is how far an observation sits from the orbit fitted to the rest: a fraction of an arcsecond is the normal scale, and a value many times larger than its neighbours marks a problem with that measurement.</string>
     </property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <widget class="QTableWidget" name="tbl_residuals">
     <property name="minimumSize"><size><width>0</width><height>300</height></size></property>
     <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
     <property name="selectionMode"><enum>QAbstractItemView::NoSelection</enum></property>
     <property name="alternatingRowColors"><bool>true</bool></property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
