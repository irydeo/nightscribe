     <property name="orientation"><enum>Qt::Vertical</enum></property>
    </spacer>
   </item>
   <item>
    <!-- Interfaz 1.6 + ADR-055: the sky, with the invitation painted ON it.
         The overlay lives on the LEFT half, which is where the SVG's scrim
         already darkens the sky for text; the right half is taken by the
         Moon and by the observatory. Two labels (a headline and a hint) and
         no button: the call to action is the one below, in the open. -->
    <layout class="QGridLayout" name="nightSkyGrid">
