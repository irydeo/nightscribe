<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>WizardDialog</class>
 <widget class="QDialog" name="WizardDialog">
  <property name="windowTitle"><string>Welcome to NightScribe</string></property>
  <property name="modal"><bool>true</bool></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="lbl_welcome">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Welcome to NightScribe! To get started, tell us your observatory. If you have an MPC code, coordinates fill in automatically.</string></property>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="grp_wiz_mpc">
     <property name="title"><string>With MPC code</string></property>
     <layout class="QHBoxLayout">
      <item><widget class="QLineEdit" name="edt_wiz_mpc"><property name="placeholderText"><string>p. ej. Z41</string></property><property name="maxLength"><number>3</number></property></widget></item>
      <item><widget class="QPushButton" name="btn_wiz_resolve"><property name="text"><string>Resolve</string></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="grp_wiz_manual">
     <property name="title"><string>Or manual</string></property>
     <layout class="QFormLayout">
      <item row="0" column="0"><widget class="QLabel" name="lbl_wiz_name"><property name="text"><string>Name:</string></property></widget></item>
      <item row="0" column="1"><widget class="QLineEdit" name="edt_wiz_name"/></item>
      <item row="1" column="0"><widget class="QLabel" name="lbl_wiz_lat"><property name="text"><string>Latitude (°):</string></property></widget></item>
      <item row="1" column="1"><widget class="QDoubleSpinBox" name="spn_wiz_lat"><property name="decimals"><number>5</number></property><property name="minimum"><double>-90.0</double></property><property name="maximum"><double>90.0</double></property></widget></item>
      <item row="2" column="0"><widget class="QLabel" name="lbl_wiz_lon"><property name="text"><string>Longitude (°, east):</string></property></widget></item>
      <item row="2" column="1"><widget class="QDoubleSpinBox" name="spn_wiz_lon"><property name="decimals"><number>5</number></property><property name="minimum"><double>-180.0</double></property><property name="maximum"><double>180.0</double></property></widget></item>
      <item row="3" column="0"><widget class="QLabel" name="lbl_wiz_h"><property name="text"><string>Height (m):</string></property></widget></item>
      <item row="3" column="1"><widget class="QSpinBox" name="spn_wiz_height"><property name="maximum"><number>9000</number></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="lbl_wiz_status">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string></string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout">
     <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
     <item><widget class="QPushButton" name="btn_wiz_ok"><property name="text"><string>Start</string></property><property name="default"><bool>true</bool></property></widget></item>
    </layout>
   </item>
  </layout>
 </widget>
