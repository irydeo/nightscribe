       <property name="text"><string>Active regions map (NOAA)</string></property>
       <property name="wordWrap"><bool>true</bool></property>
      </widget>
     </item>
     <item>
      <widget class="QTextBrowser" name="txt_sun_data">
       <property name="maximumWidth"><number>330</number></property>
       <property name="maximumHeight"><number>430</number></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="grp_almanac">
     <property name="title"><string>Moon and planets tonight</string></property>
     <layout class="QVBoxLayout">
