<?xml version="1.0" encoding="UTF-8"?>
<!--
  UFE advanced recipe dialog (ADR-044 rev): the Measure section's
  non-daily knobs in a small non-modal window. Loaded by
  gui/ufe_advanced_dialog.py through gui/ui_loader.py; the combo items
  carry userData, so they are filled in code (ADR-005: structure and
  texts here, data in code).
-->
<ui version="4.0">
 <class>UfeAdvancedDialog</class>
 <widget class="QWidget" name="UfeAdvancedDialog">
  <layout class="QVBoxLayout" name="vbox_advanced"><property name="leftMargin"><number>11</number></property><property name="topMargin"><number>11</number></property><property name="rightMargin"><number>11</number></property><property name="bottomMargin"><number>11</number></property>
   <item>
    <layout class="QHBoxLayout" name="row_sky">
     <item><widget class="QLabel" name="lbl_sky"><property name="text"><string>Sky:</string></property></widget></item>
     <item><widget class="QComboBox" name="cmb_sky"><property name="toolTip"><string>How the annulus estimates the background: a flat median, or a tilted plane when the host galaxy tilts it</string></property></widget></item>
    </layout>
   </item>
   <item><widget class="QCheckBox" name="chk_sigmaclip"><property name="text"><string>Sigma-clip the sky</string></property><property name="toolTip"><string>Two 2.5-sigma rounds on the annulus: extra skin against hot pixels and crowded cores</string></property><property name="checked"><bool>true</bool></property></widget></item>
   <item><widget class="QCheckBox" name="chk_seeing"><property name="text"><string>Aperture follows the seeing</string></property><property name="toolTip"><string>Measure the FWHM of the comparison stars and size the aperture as 1.35 times the seeing (H3)</string></property><property name="checked"><bool>true</bool></property></widget></item>
   <item>
    <layout class="QHBoxLayout" name="row_color">
     <item><widget class="QCheckBox" name="chk_color"><property name="text"><string>Colour term</string></property><property name="toolTip"><string>Fit the zero point AND its slope against the comps' B−V (H1); needs at least 6 comps with colour spread</string></property><property name="checked"><bool>true</bool></property></widget></item>
     <item><widget class="QLabel" name="lbl_bv"><property name="text"><string>B−V target:</string></property></widget></item>
     <item><widget class="QDoubleSpinBox" name="spn_target_bv"><property name="toolTip"><string>The target's B−V when known (variables: VSX). A supernova near peak is about 0; the panel warns when the colour term is applied with this assumption</string></property><property name="minimum"><double>-1.0</double></property><property name="maximum"><double>3.0</double></property><property name="decimals"><number>2</number></property><property name="singleStep"><double>0.05</double></property><property name="keyboardTracking"><bool>false</bool></property></widget></item>
    </layout>
   </item>
   <item><widget class="QCheckBox" name="chk_subtract"><property name="text"><string>Subtract host galaxy (PS1 reference)</string></property><property name="toolTip"><string>Download the aligned PanSTARRS reference, scale it so the comparison stars vanish, and measure the target on the difference image (H2b; needs network once per field)</string></property></widget></item>
   <item>
    <layout class="QHBoxLayout" name="row_group">
     <item><widget class="QLabel" name="lbl_group"><property name="text"><string>Group frames:</string></property></widget></item>
     <item><widget class="QSpinBox" name="spn_group_n"><property name="toolTip"><string>Series only: combine N frames per point in the measurement domain (fluxes with 1/σ² weights), never pixel stacking. 1 = one point per frame (the default for transits and variables)</string></property><property name="minimum"><number>1</number></property><property name="maximum"><number>100</number></property><property name="value"><number>1</number></property></widget></item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="row_detrend">
     <item><widget class="QLabel" name="lbl_detrend"><property name="text"><string>Detrend:</string></property></widget></item>
     <item><widget class="QComboBox" name="cmb_detrend"><property name="toolTip"><string>Series only: off keeps the raw curve; airmass removes the minimum (a1·exp(a2·X)+a3); auto adds FWHM/sky/x-y only when the residual really improves. The raw curve is always kept</string></property></widget></item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="row_align">
     <item><widget class="QLabel" name="lbl_align"><property name="text"><string>Align frames:</string></property></widget></item>
     <item><widget class="QComboBox" name="cmb_align"><property name="toolTip"><string>Series only: the frames of a visit rarely sit on the same pixels (the mount drifts, or the telescope was re-pointed). Auto measures each frame on its own grid at the mapped coordinates, so the star never leaves the aperture and the point spread is never resampled. Off assumes the frames are already aligned (a solved WCS per frame does the same job)</string></property></widget></item>
    </layout>
   </item>
   <item><widget class="QCheckBox" name="chk_auto_aperture"><property name="text"><string>Aperture sweep per night (T3)</string></property><property name="toolTip"><string>Series only: pick the aperture k in [1.0, 2.0]·FWHM whose check-star scatter is smallest, one choice per night</string></property></widget></item>
   <item>
    <layout class="QHBoxLayout" name="row_saturate">
     <item><widget class="QLabel" name="lbl_saturate"><property name="text"><string>Saturation (ADU):</string></property></widget></item>
     <item><widget class="QDoubleSpinBox" name="spn_saturate"><property name="toolTip"><string>The detector ceiling as an absolute ADU value, for both a single measurement and a series; 0 = use the header's SATURATE card or the Ajustes value (the line at the right shows what 0 resolves to)</string></property><property name="maximum"><double>1000000.0</double></property><property name="decimals"><number>0</number></property><property name="value"><double>0.0</double></property></widget></item>
     <item><widget class="QLabel" name="lbl_saturate_auto"><property name="text"><string/></property><property name="wordWrap"><bool>true</bool></property></widget></item>
    </layout>
   </item>
   <item><widget class="QPushButton" name="btn_restore"><property name="text"><string>Restore defaults</string></property><property name="toolTip"><string>Back to the recipe the editor ships with: sky medians with sigma-clip, seeing apertures, colour term, no grouping, no detrend</string></property></widget></item>
   <item><spacer name="vsp_advanced"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
