    <item>
     <widget class="QPushButton" name="btn_advanced">
      <property name="toolTip">
       <string>The rest of the recipe: sky model, sigma-clip, seeing apertures, colour term, host-galaxy subtraction. The matched filter has its own switch in the panel above, because it is the one that decides how the light is measured (a small window: keep measuring while it is open)</string>
      </property>
      <property name="text">
       <string>Advanced…</string>
      </property>
     </widget>
    </item>
