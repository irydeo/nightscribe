<?xml version="1.0" encoding="UTF-8"?>
<!--
  New-project dialog of the Campaigns tab (UX-a): one variable project
  linked to the selected campaign, with the VSX/SIMBAD resolution chain.
  Loaded by gui/campaigns_dialog.py through gui/ui_loader.py. The
  resolution status and the resolved fields are data, set in code
  (ADR-005).
-->
<ui version="4.0">
 <class>NewProjectDialog</class>
 <widget class="QWidget" name="NewProjectDialog">
  <layout class="QVBoxLayout" name="vbox_newproj"><property name="leftMargin"><number>11</number></property><property name="topMargin"><number>11</number></property><property name="rightMargin"><number>11</number></property><property name="bottomMargin"><number>11</number></property>
   <item><widget class="QLabel" name="lbl_intro"><property name="text"><string>Creates a new project for this object and links it to the selected campaign. If the project already exists, use “Attach project…” in the campaigns tab instead.</string></property></widget></item>
   <item>
    <layout class="QFormLayout" name="form_newproj">
