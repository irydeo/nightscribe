               </layout>
              </item>
              <item>
               <!-- ADR-041: the tab bar — the object card, the three
                    steps and the follow-up view. One flat button per
                    page; main_window paints the state (active / done /
                    current / skipped / pending) per project kind. -->
               <layout class="QHBoxLayout" name="tabLayout">
                <item>
                 <widget class="QPushButton" name="btn_tab_details">
                  <property name="flat"><bool>true</bool></property>
                 </widget>
                </item>
                <!-- ADR-043: the bar reads left to right (object card ->
                     Capture -> Process -> Publish -> Follow-up); the
                     follow-up separator is only shown for the kinds
                     that have one (main_window._render_tab_bar) -->
                <item>
                 <widget class="QLabel" name="lbl_sep_plan">
                  <property name="text"><string>→</string></property>
                  <property name="styleSheet"><string notr="true">color: #8a90a6; font-size: 13px;</string></property>
