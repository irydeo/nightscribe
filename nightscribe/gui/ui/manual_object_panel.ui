     <item row="0" column="3">
      <widget class="QComboBox" name="cmb_mf_kind">
       <item><property name="text"><string>Supernova</string></property></item>
       <item><property name="text"><string>NEO</string></property></item>
       <item><property name="text"><string>Comet</string></property></item>
       <item><property name="text"><string>PCCP</string></property></item>
       <item><property name="text"><string>Transit</string></property></item>
       <item><property name="text"><string>Variable</string></property></item>
       <item><property name="text"><string>HADS</string></property></item>
      </widget>
     </item>
     <item row="1" column="0"><widget class="QLabel" name="lbl_mf_ra"><property name="text"><string>RA (deg):</string></property></widget></item>
     <item row="1" column="1"><widget class="QLineEdit" name="edt_mf_ra"/></item>
     <item row="1" column="2"><widget class="QLabel" name="lbl_mf_dec"><property name="text"><string>Dec (deg):</string></property></widget></item>
     <item row="1" column="3"><widget class="QLineEdit" name="edt_mf_dec"/></item>
     <item row="2" column="0"><widget class="QLabel" name="lbl_mf_mag"><property name="text"><string>Magnitude:</string></property></widget></item>
     <item row="2" column="1"><widget class="QLineEdit" name="edt_mf_mag"/></item>
     <item row="2" column="2"><widget class="QLabel" name="lbl_mf_notes"><property name="text"><string>Notes / alias:</string></property></widget></item>
     <item row="2" column="3"><widget class="QLineEdit" name="edt_mf_notes"/></item>
    </layout>
   </item>
   <item>
    <widget class="QStackedWidget" name="kind_stack">
     <widget class="QWidget" name="page_sn">
      <layout class="QGridLayout" name="snGrid">
