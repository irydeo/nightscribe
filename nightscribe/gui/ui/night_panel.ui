<?xml version="1.0" encoding="UTF-8"?>
<!--
  Interfaz 1.6: the resting page of the projects detail pane.

  When no project is selected the right pane shows the night instead of an
  empty box: the same painted sky as the Welcome hero (with tonight's real
  Moon), the darkness window, the planets at dusk and the way in to a new
  project. The structure, texts and tooltips live here (ADR-005); the code
  (gui/widgets/night_panel.py) swaps nightSkyHost for the painted sky and
  fills the lines from core/night_brief.
-->
<ui version="4.0">
