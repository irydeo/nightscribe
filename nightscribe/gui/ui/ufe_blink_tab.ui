     <item><widget class="QSlider" name="sld_fade"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property><property name="value"><number>50</number></property><property name="enabled"><bool>false</bool></property></widget></item>
