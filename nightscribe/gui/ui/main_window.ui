<?xml version="1.0" encoding="UTF-8"?>
<!--
  Interfaz 1.0: the app shell. A vertical "PROYECTOS" tab on the left always
  visible, a QStackedWidget with the views (Home, Tonight, Campaigns,
  Detail) and an overlay project drawer built in code (gui/main_window.py).
  The old QTabWidget is gone; the same widgets are hosted here full-screen.
-->
