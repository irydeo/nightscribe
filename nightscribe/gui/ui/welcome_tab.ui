<?xml version="1.0" encoding="UTF-8"?>
<!--
  Interfaz 1.0 (ADR-053): the Welcome view. It hosts the first-run / update
  wizard as an inline stepper (Observatory -> Targets -> Data) instead of the
  old modal QWizard. The structure, texts and tooltips live here (ADR-005);
  gui/widgets/welcome_setup.py wires the signals, fills the kinds list and
  the migration report, and gates navigation on the update's Data step.
-->
<ui version="4.0">
 <class>WelcomeTab</class>
