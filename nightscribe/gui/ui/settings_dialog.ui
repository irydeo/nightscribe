<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SettingsDialog</class>
 <widget class="QDialog" name="SettingsDialog">
  <property name="windowTitle"><string>Settings</string></property>
  <property name="modal"><bool>true</bool></property>
  <property name="minimumSize"><size><width>800</width><height>720</height></size></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="tabPosition">
      <enum>QTabWidget::North</enum>
     </property>
     <widget class="QWidget" name="tab_site">
      <attribute name="title"><string>Site &amp; equipment</string></attribute>
      <layout class="QVBoxLayout" name="vbox_site">
       <item>
        <widget class="QGroupBox" name="grp_language">
         <property name="title"><string>Language</string></property>
         <layout class="QFormLayout">
          <item row="0" column="0"><widget class="QLabel" name="lbl_language"><property name="text"><string>Interface language:</string></property></widget></item>
          <item row="0" column="1">
           <widget class="QComboBox" name="cmb_language">
            <property name="toolTip"><string>Applies after restarting the app</string></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grp_site">
         <property name="title"><string>Observatory</string></property>
         <layout class="QGridLayout" name="grid_site">
          <property name="columnStretch">
           <number>0</number>
           <number>0</number>
           <number>1</number>
          </property>
          <item row="0" column="0"><widget class="QLabel" name="lbl_mpc"><property name="text"><string>MPC code:</string></property></widget></item>
          <item row="0" column="1"><widget class="QLineEdit" name="edt_mpc_code"><property name="maxLength"><number>3</number></property><property name="maximumSize"><size><width>80</width><height>16777215</height></size></property><property name="toolTip"><string>Your MPC observatory code (e.g. Z41). Coordinates resolve automatically.</string></property></widget></item>
          <item row="0" column="2"><widget class="QPushButton" name="btn_resolve"><property name="text"><string>Resolve coordinates</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lbl_name"><property name="text"><string>Name:</string></property></widget></item>
          <item row="1" column="1" colspan="2"><widget class="QLineEdit" name="edt_obs_name"/></item>
          <item row="2" column="0"><widget class="QLabel" name="lbl_lat"><property name="text"><string>Latitude (°):</string></property></widget></item>
          <item row="2" column="1"><widget class="QDoubleSpinBox" name="spn_lat"><property name="decimals"><number>5</number></property><property name="minimum"><double>-90.0</double></property><property name="maximum"><double>90.0</double></property></widget></item>
          <item row="3" column="0"><widget class="QLabel" name="lbl_lon"><property name="text"><string>Longitude (°, east):</string></property></widget></item>
          <item row="3" column="1"><widget class="QDoubleSpinBox" name="spn_lon"><property name="decimals"><number>5</number></property><property name="minimum"><double>-180.0</double></property><property name="maximum"><double>180.0</double></property></widget></item>
           <item row="4" column="0"><widget class="QLabel" name="lbl_height"><property name="text"><string>Height (m):</string></property></widget></item>
           <item row="4" column="1"><widget class="QSpinBox" name="spn_height"><property name="maximum"><number>9000</number></property></widget></item>
           <item row="5" column="0"><widget class="QLabel" name="lbl_aavso"><property name="text"><string>AAVSO code:</string></property></widget></item>
           <item row="5" column="1"><widget class="QLineEdit" name="edt_aavso_code"><property name="maxLength"><number>6</number></property><property name="maximumSize"><size><width>80</width><height>16777215</height></size></property><property name="toolTip"><string>Your AAVSO observer code (blank if none). Written into the EXOTIC inits.json handoff.</string></property></widget></item>
          </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grp_equip">
         <property name="title"><string>Equipment and limits</string></property>
         <layout class="QFormLayout">
          <item row="0" column="0"><widget class="QLabel" name="lbl_aperture"><property name="text"><string>Aperture (inches):</string></property></widget></item>
          <item row="0" column="1"><widget class="QDoubleSpinBox" name="spn_aperture"><property name="maximum"><double>100.0</double></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lbl_limit"><property name="text"><string>Limiting magnitude:</string></property></widget></item>
          <item row="1" column="1"><widget class="QDoubleSpinBox" name="spn_limit_mag"><property name="maximum"><double>25.0</double></property></widget></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grp_camera">
         <property name="title"><string>Camera (plate scale)</string></property>
         <layout class="QFormLayout">
          <item row="0" column="0"><widget class="QLabel" name="lbl_pixel"><property name="text"><string>Pixel size (µm):</string></property></widget></item>
          <item row="0" column="1"><widget class="QDoubleSpinBox" name="spn_pixel_um"><property name="decimals"><number>2</number></property><property name="minimum"><double>1.0</double></property><property name="maximum"><double>30.0</double></property><property name="toolTip"><string>Camera pixel size in microns (e.g. 3.76 for a QHY600)</string></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="lbl_focal"><property name="text"><string>Focal length (mm):</string></property></widget></item>
           <item row="1" column="1"><widget class="QDoubleSpinBox" name="spn_focal_mm"><property name="decimals"><number>0</number></property><property name="minimum"><double>50.0</double></property><property name="maximum"><double>20000.0</double></property><property name="toolTip"><string>Telescope focal length in mm (e.g. 2000 for a 8&quot; f/10 SCT)</string></property></widget></item>
           <item row="2" column="0"><widget class="QLabel" name="lbl_camtype"><property name="text"><string>Camera type:</string></property></widget></item>
           <item row="2" column="1"><widget class="QComboBox" name="cmb_camera_type"><property name="toolTip"><string>CCD, CMOS or DSLR — written into the EXOTIC inits.json handoff</string></property></widget></item>
           <item row="3" column="0"><widget class="QLabel" name="lbl_binning"><property name="text"><string>Pixel binning:</string></property></widget></item>
           <item row="3" column="1"><widget class="QComboBox" name="cmb_binning"><property name="editable"><bool>true</bool></property><property name="toolTip"><string>On-chip binning (e.g. 1x1, 2x2) — written into the EXOTIC inits.json handoff</string></property></widget></item>
          </layout>
        </widget>
       </item>
       <item>
        <spacer name="vspacer_site">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab_observing">
      <attribute name="title"><string>Observing</string></attribute>
      <layout class="QVBoxLayout" name="vbox_observing">
       <item>
        <widget class="QGroupBox" name="grp_horizon">
         <property name="title"><string>Local limit</string></property>
         <layout class="QFormLayout" name="form_horizon">
          <item row="0" column="0"><widget class="QLabel" name="lbl_hfile"><property name="text"><string>Limit file:</string></property></widget></item>
          <item row="0" column="1">
           <layout class="QHBoxLayout">
            <item><widget class="QLineEdit" name="edt_horizon_file"><property name="toolTip"><string>Limits file: TheSkyX limits export (.hrz) or plain "az alt" pairs. If it loads, the file is the safety reference and the flat minimum altitude is ignored.</string></property></widget></item>
            <item><widget class="QPushButton" name="btn_horizon_browse"><property name="text"><string>Browse…</string></property></widget></item>
           </layout>
          </item>
          <item row="1" column="0"><widget class="QLabel" name="lbl_hmargin"><property name="text"><string>Safety margin (°):</string></property></widget></item>
          <item row="1" column="1"><widget class="QDoubleSpinBox" name="spn_horizon_margin"><property name="decimals"><number>1</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>20.0</double></property><property name="toolTip"><string>Extra clearance added on top of the limit for safety</string></property></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="lbl_minalt"><property name="text"><string>Minimum altitude (°):</string></property></widget></item>
          <item row="2" column="1"><widget class="QDoubleSpinBox" name="spn_min_alt"><property name="maximum"><double>89.0</double></property><property name="toolTip"><string>Flat altitude floor used only when no limit file is loaded; the limit file, when present, is the safety reference</string></property></widget></item>
          <item row="3" column="0" colspan="2"><widget class="QLabel" name="lbl_horizon_stats"><property name="wordWrap"><bool>true</bool></property><property name="toolTip"><string>Summary of the loaded limit file: min/max altitude, peak azimuth and point count. If it cannot be read, the flat minimum altitude is used instead.</string></property></widget></item>
         </layout>
        </widget>
       </item>
        <item>
         <widget class="QGroupBox" name="grp_kinds">
          <property name="title"><string>Tonight: object kinds</string></property>
          <layout class="QFormLayout">
           <item row="0" column="0" colspan="2"><widget class="QLabel" name="lbl_kinds_hint"><property name="text"><string>Enable the kinds that can appear in the Tonight tab and in its header filter (at least one).</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
           <item row="1" column="0" colspan="2"><widget class="QCheckBox" name="chk_kind_neo"><property name="text"><string>NEOs</string></property></widget></item>
           <item row="2" column="0" colspan="2"><widget class="QCheckBox" name="chk_kind_sn"><property name="text"><string>Supernovae</string></property></widget></item>
           <item row="3" column="0" colspan="2"><widget class="QCheckBox" name="chk_kind_comet"><property name="text"><string>Comets</string></property></widget></item>
           <item row="4" column="0" colspan="2"><widget class="QCheckBox" name="chk_kind_pccp"><property name="text"><string>PCCP candidates</string></property></widget></item>
           <item row="5" column="0" colspan="2"><widget class="QCheckBox" name="chk_kind_transit"><property name="text"><string>Exoplanet transits</string></property></widget></item>
           <item row="6" column="0" colspan="2"><widget class="QCheckBox" name="chk_kind_alert"><property name="text"><string>Close approaches (alerts)</string></property></widget></item>
           <item row="7" column="0"><widget class="QLabel" name="lbl_best_pk"><property name="text"><string>Shown per kind (Tonight):</string></property></widget></item>
           <item row="7" column="1">
            <widget class="QSpinBox" name="spn_best_pk">
             <property name="minimum"><number>1</number></property>
             <property name="maximum"><number>50</number></property>
             <property name="toolTip"><string>Cap for the Tonight grid: at most this many targets per object kind, best first (the full list stays in the table below).</string></property>
            </widget>
           </item>
          </layout>
         </widget>
        </item>
         <item>
          <widget class="QGroupBox" name="grp_transits">
           <property name="title"><string>Exoplanet transits</string></property>
           <layout class="QFormLayout">
            <item row="0" column="0" colspan="2"><widget class="QCheckBox" name="chk_transit_scope_filter"><property name="text"><string>Hide transits that need a bigger telescope than mine</string></property><property name="toolTip"><string>ExoClock estimates the minimum aperture each transit needs; when checked, Tonight drops the events above your aperture (Site tab)</string></property></widget></item>
           </layout>
          </widget>
         </item>
        <item>
         <widget class="QGroupBox" name="grp_moon">
          <property name="title"><string>Moon constraint</string></property>
         <layout class="QFormLayout">
          <item row="0" column="0" colspan="2"><widget class="QCheckBox" name="chk_moon_enabled"><property name="text"><string>Warn when Moon interferes</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lbl_moonsep"><property name="text"><string>Min separation (°):</string></property></widget></item>
          <item row="1" column="1"><widget class="QDoubleSpinBox" name="spn_moon_sep"><property name="decimals"><number>0</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>180.0</double></property></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="lbl_moonillum"><property name="text"><string>Max illumination:</string></property></widget></item>
          <item row="2" column="1"><widget class="QDoubleSpinBox" name="spn_moon_illum"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>1.0</double></property><property name="singleStep"><double>0.05</double></property></widget></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grp_session">
         <property name="title"><string>Session defaults</string></property>
          <layout class="QFormLayout">
           <item row="0" column="0"><widget class="QLabel" name="lbl_overhead"><property name="text"><string>Per-frame overhead (s):</string></property></widget></item>
           <item row="0" column="1"><widget class="QDoubleSpinBox" name="spn_overhead"><property name="decimals"><number>0</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>120.0</double></property><property name="toolTip"><string>Readout/slew overhead added to every exposure frame</string></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="lbl_sn_cadence"><property name="text"><string>SN revisit reminder (days):</string></property></widget></item>
           <item row="1" column="1"><widget class="QSpinBox" name="spn_sn_cadence"><property name="minimum"><number>1</number></property><property name="maximum"><number>30</number></property><property name="toolTip"><string>Show a reminder when an active SN project has not been visited in this many nights</string></property></widget></item>
          </layout>
        </widget>
       </item>
       <item>
        <spacer name="vspacer_observing">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
        </spacer>
       </item>
      </layout>
     </widget>
      <widget class="QWidget" name="tab_integrations">
      <attribute name="title"><string>Integrations</string></attribute>
      <layout class="QVBoxLayout" name="vbox_integrations">
       <item>
        <widget class="QGroupBox" name="grp_misc">
         <property name="title"><string>API keys (all optional)</string></property>
         <layout class="QFormLayout">
          <item row="0" column="0"><widget class="QLabel" name="lbl_nfkey"><property name="text"><string>NEOfixer API key:</string></property></widget></item>
          <item row="0" column="1"><widget class="QLineEdit" name="edt_neofixer_key"><property name="echoMode"><enum>QLineEdit::Password</enum></property><property name="toolTip"><string>Optional: report your observing status to NEOfixer</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lbl_astrokey"><property name="text"><string>Astrometry.net API key:</string></property></widget></item>
          <item row="1" column="1"><widget class="QLineEdit" name="edt_astrometry_key"><property name="echoMode"><enum>QLineEdit::Password</enum></property><property name="toolTip"><string>Optional: blind-solve FITS without WCS in the Blink tab (free key from nova.astrometry.net)</string></property></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="lbl_tnsbot"><property name="text"><string>TNS bot name:</string></property></widget></item>
          <item row="2" column="1"><widget class="QLineEdit" name="edt_tns_bot"><property name="toolTip"><string>Optional: TNS bot credentials to fetch discovery images for transients</string></property></widget></item>
          <item row="3" column="0"><widget class="QLabel" name="lbl_tnskey"><property name="text"><string>TNS bot key:</string></property></widget></item>
          <item row="3" column="1"><widget class="QLineEdit" name="edt_tns_bot_key"><property name="echoMode"><enum>QLineEdit::Password</enum></property><property name="toolTip"><string>Optional: TNS bot credentials to fetch discovery images for transients</string></property></widget></item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="vspacer_integrations">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
        </spacer>
       </item>
      </layout>
      </widget>
      <widget class="QWidget" name="tab_ccdciel">
       <attribute name="title"><string>CCDciel</string></attribute>
       <layout class="QVBoxLayout" name="vbox_ccdciel">
        <item>
         <widget class="QGroupBox" name="grp_ccdciel">
          <property name="title"><string>JSON-RPC connection</string></property>
          <layout class="QFormLayout">
           <item row="0" column="0"><widget class="QLabel" name="lbl_ccdhost"><property name="text"><string>Host:</string></property></widget></item>
           <item row="0" column="1"><widget class="QLineEdit" name="edt_ccdciel_host"><property name="toolTip"><string>Address of the computer running CCDciel (usually 127.0.0.1)</string></property></widget></item>
           <item row="1" column="0"><widget class="QLabel" name="lbl_ccdport"><property name="text"><string>Port:</string></property></widget></item>
           <item row="1" column="1"><widget class="QSpinBox" name="spn_ccdciel_port"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>3277</number></property></widget></item>
           <item row="2" column="0"><widget class="QLabel" name="lbl_ccdauto"><property name="text"><string>Auto-connect on start:</string></property></widget></item>
           <item row="2" column="1"><widget class="QCheckBox" name="chk_ccdciel_auto"><property name="toolTip"><string>Connect to CCDciel automatically when the app starts (off by default)</string></property></widget></item>
          </layout>
         </widget>
        </item>
        <item>
         <spacer name="vspacer_ccdciel">
          <property name="orientation"><enum>Qt::Vertical</enum></property>
         </spacer>
        </item>
       </layout>
      </widget>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="standardButtons"><set>QDialogButtonBox::Save|QDialogButtonBox::Cancel</set></property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
