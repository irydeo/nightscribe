<?xml version="1.0" encoding="UTF-8"?>
<!--
  UFE Blink tab (ADR-044, phase E): live blink against the survey
  reference. Loaded by gui/ufe_blink_tab.py through gui/ui_loader.py.
  The zoom combo's items carry userData and the nudge readout is data:
  both are set in code (ADR-005).
-->
<ui version="4.0">
 <class>UfeBlinkTab</class>
 <widget class="QWidget" name="UfeBlinkTab">
  <layout class="QVBoxLayout" name="vbox_blink"><property name="leftMargin"><number>9</number></property><property name="topMargin"><number>9</number></property><property name="rightMargin"><number>9</number></property><property name="bottomMargin"><number>9</number></property>
