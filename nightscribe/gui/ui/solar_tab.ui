      <widget class="QLabel" name="lbl_sun_image">
       <property name="alignment"><enum>Qt::AlignCenter</enum></property>
       <property name="minimumSize"><size><width>430</width><height>430</height></size></property>
       <property name="maximumSize"><size><width>430</width><height>430</height></size></property>
       <property name="text"><string>Press Refresh to load today's Sun (NASA SDO)</string></property>
       <property name="wordWrap"><bool>true</bool></property>
