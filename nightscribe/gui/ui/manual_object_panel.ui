<?xml version="1.0" encoding="UTF-8"?>
<!--
  Interfaz 1.0 (ADR-053): the manual object form. When the name search does
  not locate an object, the observer types its data here and the project is
  created just the same. Common fields for every kind; the kind-specific
  block swaps with the Type combo (ADR-005: structure and texts live here,
  gui/widgets/manual_object_panel.py wires and reads them).
-->
<ui version="4.0">
 <class>ManualObjectPanel</class>
 <widget class="QWidget" name="ManualObjectPanel">
  <layout class="QVBoxLayout" name="mfLayout">
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <item>
    <widget class="QLabel" name="lbl_mf_title">
     <property name="text"><string>Create the object by hand</string></property>
     <property name="styleSheet"><string notr="true">font-size: 14px; font-weight: bold;</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="lbl_mf_sub">
     <property name="text"><string>It was not located. Fill in its data and the project is created just the same: record, capture, analysis and publishing.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
     <property name="styleSheet"><string notr="true">color: #8a90a6;</string></property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="commonGrid">
     <item row="0" column="0"><widget class="QLabel" name="lbl_mf_name"><property name="text"><string>Name:</string></property></widget></item>
     <item row="0" column="1"><widget class="QLineEdit" name="edt_mf_name"/></item>
