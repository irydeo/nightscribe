         <property name="wordWrap"><bool>true</bool></property>
         <property name="text"><string></string></property>
         <property name="styleSheet"><string notr="true">background-color: #3a3020; color: #e0c060; border: 1px solid #5a4a20; border-radius: 4px; padding: 6px;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QTabWidget" name="tabs_steps">
         <property name="currentIndex"><number>0</number></property>
         <widget class="QWidget" name="tab_details">
          <attribute name="title"><string>Details</string></attribute>
          <layout class="QVBoxLayout" name="detailsLayout"/>
         </widget>
         <widget class="QWidget" name="tab_plan">
          <attribute name="title"><string>Plan</string></attribute>
