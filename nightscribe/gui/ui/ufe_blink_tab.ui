     <item><widget class="QLabel" name="lbl_interval"><property name="text"><string>Interval:</string></property></widget></item>
     <item><widget class="QSpinBox" name="spn_interval"><property name="minimum"><number>100</number></property><property name="maximum"><number>5000</number></property><property name="value"><number>500</number></property><property name="suffix"><string notr="true"> ms</string></property></widget></item>
