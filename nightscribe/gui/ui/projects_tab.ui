      </item>
      <item>
       <widget class="QLabel" name="lbl_step_status">
        <property name="wordWrap"><bool>true</bool></property>
        <property name="text"><string>—</string></property>
       </widget>
      </item>
      <item>
       <layout class="QHBoxLayout" name="navBtns">
        <item><widget class="QPushButton" name="btn_prev"><property name="text"><string>← Previous</string></property></widget></item>
