        </item>
        <item><widget class="QPushButton" name="btn_refresh"><property name="text"><string>Refresh</string></property></widget></item>
       </layout>
      </item>
      <item>
       <widget class="QListWidget" name="lst_projects">
        <property name="toolTip"><string>Select a project to see its guided steps</string></property>
       </widget>
      </item>
       <item>
        <layout class="QHBoxLayout">
         <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
