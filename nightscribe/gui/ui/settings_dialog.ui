<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SettingsDialog</class>
 <widget class="QDialog" name="SettingsDialog">
  <property name="windowTitle"><string>Settings</string></property>
  <property name="modal"><bool>true</bool></property>
  <property name="minimumSize"><size><width>900</width><height>620</height></size></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item><widget class="QLineEdit" name="edt_search"><property name="placeholderText"><string>Search settings…</string></property></widget></item>
   <item>
    <layout class="QHBoxLayout" name="hbox_body">
     <item><widget class="QListWidget" name="lst_categories"><property name="minimumSize"><size><width>64</width><height>0</height></size></property><property name="maximumSize"><size><width>64</width><height>16777215</height></size></property></widget></item>
     <item>
      <widget class="QStackedWidget" name="stk_pages">
       <widget class="QScrollArea" name="scr_observatory">
        <property name="widgetResizable"><bool>true</bool></property>
        <widget class="QWidget" name="page_observatory">
         <layout class="QVBoxLayout" name="vbox_observatory">
          <item>
           <widget class="QGroupBox" name="grp_site">
            <property name="title"><string>Observatory</string></property>
            <layout class="QVBoxLayout" name="vbox_site_grp">
             <item>
              <layout class="QHBoxLayout" name="row_mpc">
               <item><widget class="QLabel" name="lbl_mpc"><property name="text"><string>MPC code:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_mpc_code"><property name="maxLength"><number>3</number></property><property name="maximumSize"><size><width>80</width><height>16777215</height></size></property></widget></item>
               <item><widget class="QPushButton" name="btn_resolve"><property name="text"><string>Resolve coordinates</string></property></widget></item>
               <item><widget class="QPushButton" name="btn_map_pick"><property name="text"><string>Pick on the map…</string></property><property name="toolTip"><string>Choose the observatory on a world map, with the night side shown as it is right now</string></property></widget></item>
               <item>
                <spacer name="hsp_mpc">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_mpc"><property name="text"><string>Your MPC observatory code; the site coordinates resolve automatically from it</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_name">
               <item><widget class="QLabel" name="lbl_name"><property name="text"><string>Name:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_obs_name"/></item>
               <item>
                <spacer name="hsp_name">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_name"><property name="text"><string>Free-text observatory name (posts, reports)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_lat">
               <item><widget class="QLabel" name="lbl_lat"><property name="text"><string>Latitude (°):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_lat"><property name="decimals"><number>5</number></property><property name="minimum"><double>-90.0</double></property><property name="maximum"><double>90.0</double></property></widget></item>
               <item>
                <spacer name="hsp_lat">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_lat"><property name="text"><string>Decimal degrees; north is positive. Your site latitude.</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_lon">
               <item><widget class="QLabel" name="lbl_lon"><property name="text"><string>Longitude (°, east):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_lon"><property name="decimals"><number>5</number></property><property name="minimum"><double>-180.0</double></property><property name="maximum"><double>180.0</double></property></widget></item>
               <item>
                <spacer name="hsp_lon">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_lon"><property name="text"><string>Decimal degrees; east is positive. Your site longitude.</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_height">
               <item><widget class="QLabel" name="lbl_height"><property name="text"><string>Height (m):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QSpinBox" name="spn_height"><property name="maximum"><number>9000</number></property></widget></item>
               <item>
                <spacer name="hsp_height">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_height"><property name="text"><string>Altitude of the observatory above sea level (m) — enters the parallax and atmospheric terms</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_aavso">
               <item><widget class="QLabel" name="lbl_aavso"><property name="text"><string>AAVSO code:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_aavso_code"><property name="maxLength"><number>6</number></property><property name="maximumSize"><size><width>80</width><height>16777215</height></size></property></widget></item>
               <item>
                <spacer name="hsp_aavso">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_aavso"><property name="text"><string>Optional; written into the EXOTIC inits.json handoff (transit projects)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>
       <widget class="QScrollArea" name="scr_equipment">
        <property name="widgetResizable"><bool>true</bool></property>
        <widget class="QWidget" name="page_equipment">
         <layout class="QVBoxLayout" name="vbox_equipment">
          <item>
           <widget class="QGroupBox" name="grp_equip">
            <property name="title"><string>Telescope and limits</string></property>
            <layout class="QVBoxLayout" name="vbox_equip">
             <item>
              <layout class="QHBoxLayout" name="row_aperture">
               <item><widget class="QLabel" name="lbl_aperture"><property name="text"><string>Aperture (inches):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_aperture"><property name="maximum"><double>100.0</double></property></widget></item>
               <item>
                <spacer name="hsp_aperture">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_aperture"><property name="text"><string>Scope aperture in inches; used to size transit targets and scale the “why tonight” reasons</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_limit">
               <item><widget class="QLabel" name="lbl_limit"><property name="text"><string>Limiting magnitude:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_limit_mag"><property name="maximum"><double>25.0</double></property></widget></item>
               <item>
                <spacer name="hsp_limit">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_limit"><property name="text"><string>Faintest object you can realistically detect at your site; caps the Tonight scoring</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_camera">
            <property name="title"><string>Camera</string></property>
            <layout class="QVBoxLayout" name="vbox_camera">
             <item>
              <layout class="QHBoxLayout" name="row_campreset">
               <item><widget class="QLabel" name="lbl_campreset"><property name="text"><string>Preset:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QComboBox" name="cmb_cam_preset"/></item>
               <item>
                <spacer name="hsp_campreset">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_campreset"><property name="text"><string>Fills the pixel size and a starting profile. Linearity and the working max exposure are per gain: measure yours (the suggested value is only a starting point)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_pixel">
               <item><widget class="QLabel" name="lbl_pixel"><property name="text"><string>Pixel size (µm):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_pixel_um"><property name="decimals"><number>2</number></property><property name="minimum"><double>1.0</double></property><property name="maximum"><double>30.0</double></property></widget></item>
               <item>
                <spacer name="hsp_pixel">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_pixel"><property name="text"><string>Camera pixel size in microns (3.76 for a QHY600); sets arcsec/pixel with focal length</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_focal">
               <item><widget class="QLabel" name="lbl_focal"><property name="text"><string>Focal length (mm):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_focal_mm"><property name="decimals"><number>0</number></property><property name="minimum"><double>50.0</double></property><property name="maximum"><double>20000.0</double></property></widget></item>
               <item>
                <spacer name="hsp_focal">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_focal"><property name="text"><string>Telescope focal length in mm; together with the pixel size it sets the arcsec/pixel scale</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_camtype">
               <item><widget class="QLabel" name="lbl_camtype"><property name="text"><string>Camera type:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QComboBox" name="cmb_camera_type"/></item>
               <item>
                <spacer name="hsp_camtype">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_camtype"><property name="text"><string>CCD, CMOS or DSLR; goes into the EXOTIC inits.json handoff and into the MPC report's instrument type (ADES mode CCD/CMO, 80-column column 15 C/B)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_binning">
               <item><widget class="QLabel" name="lbl_binning"><property name="text"><string>Pixel binning:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QComboBox" name="cmb_binning"><property name="editable"><bool>true</bool></property></widget></item>
               <item>
                <spacer name="hsp_binning">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_binning"><property name="text"><string>On-chip binning (1x1, 2x2…); written into the EXOTIC inits.json handoff</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_camprofile">
               <item><widget class="QLabel" name="lbl_camfull"><property name="text"><string>Full well (e-):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_cam_full_well"><property name="maximum"><double>10000000.000000000000000</double></property><property name="decimals"><number>0</number></property></widget></item>
               <item><widget class="QLabel" name="lbl_camlin"><property name="text"><string>Linearity (ADU):</string></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_cam_linearity"><property name="toolTip"><string>Peak ADU below which the sensor is linear (per gain). Above it a star calibrates nothing and the app excludes those comps. 0 = use SATURATE/settings</string></property><property name="maximum"><double>1000000.000000000000000</double></property><property name="decimals"><number>0</number></property></widget></item>
              </layout>
             </item>
             <item>
              <layout class="QHBoxLayout" name="row_camgain">
               <item><widget class="QLabel" name="lbl_camgain"><property name="text"><string>System gain (e-/ADU):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_cam_gain"><property name="toolTip"><string>Electrons per ADU of YOUR camera at YOUR gain setting. It is what turns the error bar into an honest CCD equation instead of the scatter of the comparison stars, and it is per unit: measure it (0 = unknown)</string></property><property name="maximum"><double>100.000000000000000</double></property><property name="decimals"><number>3</number></property><property name="singleStep"><double>0.010000000000000</double></property></widget></item>
               <item><widget class="QLabel" name="lbl_camron"><property name="text"><string>Read noise (e-):</string></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_cam_ron"><property name="toolTip"><string>Read noise in electrons at the same gain. Usually a datasheet value (the preset fills it); 0 = unknown</string></property><property name="maximum"><double>200.000000000000000</double></property><property name="decimals"><number>2</number></property></widget></item>
              </layout>
             </item>
             <item>
              <layout class="QHBoxLayout" name="row_camprofile2">
               <item><widget class="QLabel" name="lbl_camdark"><property name="text"><string>Dark (e-/pix/s):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_cam_dark"><property name="maximum"><double>1000.000000000000000</double></property><property name="decimals"><number>6</number></property></widget></item>
               <item><widget class="QLabel" name="lbl_camax"><property name="text"><string>Max exposure (s):</string></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_cam_max_exp"><property name="toolTip"><string>Working maximum exposure (per gain). 0 = no cap. For an sCMOS (GSENSE400) it is a few seconds and grouping adds the rest</string></property><property name="maximum"><double>36000.000000000000000</double></property><property name="decimals"><number>0</number></property></widget></item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lbl_cam_ref"><property name="text"><string/></property><property name="wordWrap"><bool>true</bool></property></widget></item>
             <item><widget class="QLabel" name="lbl_cam_gain_note"><property name="text"><string/></property><property name="wordWrap"><bool>true</bool></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_camgain_measure">
               <item>
                <widget class="QPushButton" name="btn_measure_gain">
                 <property name="toolTip">
                  <string>Measure the gain of your camera on two of your own frames of the same exposure and remember it, so a single image can reuse it. The gain is the conversion factor (e-/ADU) the error bar hangs on; the FITS header often carries the camera's setting or a placeholder instead</string>
                 </property>
                 <property name="text">
                  <string>Measure gain…</string>
                 </property>
                </widget>
               </item>
               <item>
                <spacer name="hsp_camgain_measure">
                 <property name="orientation">
                  <enum>Qt::Horizontal</enum>
                 </property>
                 <property name="sizeHint" stdset="0">
                  <size>
                   <width>40</width>
                   <height>20</height>
                  </size>
                 </property>
                </spacer>
               </item>
              </layout>
             </item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>
       <widget class="QScrollArea" name="scr_observing">
        <property name="widgetResizable"><bool>true</bool></property>
        <widget class="QWidget" name="page_observing">
         <layout class="QVBoxLayout" name="vbox_observing">
          <item>
           <widget class="QGroupBox" name="grp_horizon">
            <property name="title"><string>Local limit</string></property>
            <layout class="QVBoxLayout" name="vbox_horizon">
             <item>
              <layout class="QHBoxLayout" name="row_hfile">
               <item><widget class="QLabel" name="lbl_hfile"><property name="text"><string>Limit file:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_horizon_file"/></item>
               <item><widget class="QPushButton" name="btn_horizon_browse"><property name="text"><string>Browse…</string></property></widget></item>
               <item>
                <spacer name="hsp_hfile">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_hfile"><property name="text"><string>TheSkyX .hrz or “az alt” pairs; when it loads, the file is the safety reference</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_hmargin">
               <item><widget class="QLabel" name="lbl_hmargin"><property name="text"><string>Safety margin (°):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_horizon_margin"><property name="decimals"><number>1</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>20.0</double></property></widget></item>
               <item>
                <spacer name="hsp_hmargin">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_hmargin"><property name="text"><string>Extra degrees of clearance added on top of the limit, for the Sun and for slew safety</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_minalt">
               <item><widget class="QLabel" name="lbl_minalt"><property name="text"><string>Minimum altitude (°):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_min_alt"><property name="maximum"><double>89.0</double></property></widget></item>
               <item>
                <spacer name="hsp_minalt">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_minalt"><property name="text"><string>Flat altitude floor, used only when no limit file is loaded</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item><widget class="QLabel" name="lbl_horizon_stats"><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_kinds">
            <property name="title"><string>Tonight: object kinds</string></property>
            <layout class="QVBoxLayout" name="vbox_kinds">
             <item>
              <layout class="QGridLayout" name="grid_kinds">
               <property name="horizontalSpacing"><number>12</number></property>
               <item row="0" column="0"><widget class="QCheckBox" name="chk_kind_neo"><property name="text"><string>NEOs</string></property></widget></item>
               <item row="0" column="1"><widget class="QCheckBox" name="chk_kind_sn"><property name="text"><string>Supernovae</string></property></widget></item>
               <item row="1" column="0"><widget class="QCheckBox" name="chk_kind_comet"><property name="text"><string>Comets</string></property></widget></item>
               <item row="1" column="1"><widget class="QCheckBox" name="chk_kind_pccp"><property name="text"><string>PCCP candidates</string></property></widget></item>
               <item row="2" column="0"><widget class="QCheckBox" name="chk_kind_transit"><property name="text"><string>Exoplanet transits</string></property></widget></item>
               <item row="2" column="1"><widget class="QCheckBox" name="chk_kind_alert"><property name="text"><string>Close approaches (alerts)</string></property></widget></item>
               <item row="3" column="0"><widget class="QCheckBox" name="chk_kind_hads"><property name="text"><string>HADS variable stars</string></property></widget></item>
               <item row="3" column="1"><widget class="QCheckBox" name="chk_kind_variable"><property name="text"><string>Variable stars</string></property></widget></item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_kinds"><property name="text"><string>Which kinds are scored and shown for Tonight and Explore; untick a kind to hide it everywhere</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_bestpk">
               <item><widget class="QLabel" name="lbl_best_pk"><property name="text"><string>Shown per kind (Tonight):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QSpinBox" name="spn_best_pk"><property name="minimum"><number>1</number></property><property name="maximum"><number>50</number></property></widget></item>
               <item>
                <spacer name="hsp_bestpk">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_bestpk"><property name="text"><string>How many entries of each kind the Tonight grid lists (more in Explore)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_transits">
            <property name="title"><string>Exoplanet transits</string></property>
            <layout class="QVBoxLayout" name="vbox_transits">
             <item><widget class="QCheckBox" name="chk_transit_scope_filter"><property name="text"><string>Hide transits that need a bigger telescope than mine</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
             <item><widget class="QLabel" name="lblH_scope_filter"><property name="text"><string>ExoClock drops transits too big for your scope when checked</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_moon">
            <property name="title"><string>Moon constraint</string></property>
            <layout class="QVBoxLayout" name="vbox_moon">
             <item><widget class="QCheckBox" name="chk_moon_enabled"><property name="text"><string>Warn when Moon interferes</string></property></widget></item>
             <item><widget class="QLabel" name="lblH_moonwarn"><property name="text"><string>Flags targets that sit too close to a bright, high Moon</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_moonsep">
               <item><widget class="QLabel" name="lbl_moonsep"><property name="text"><string>Min separation (°):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_moon_sep"><property name="decimals"><number>0</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>180.0</double></property></widget></item>
               <item>
                <spacer name="hsp_moonsep">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_moonsep"><property name="text"><string>Target-to-Moon angular distance below which the warning fires (degrees)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_moonillum">
               <item><widget class="QLabel" name="lbl_moonillum"><property name="text"><string>Max illumination:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_moon_illum"><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>1.0</double></property><property name="singleStep"><double>0.05</double></property></widget></item>
               <item>
                <spacer name="hsp_moonillum">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_moonillum"><property name="text"><string>Fraction of the lunar disk lit above which the warning starts (0.5 = half Moon)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item><widget class="QCheckBox" name="chk_moons_all"><property name="text"><string>Also list Jupiter's moon transits when Jupiter is not up (dimmed)</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_session">
            <property name="title"><string>Session defaults</string></property>
            <layout class="QVBoxLayout" name="vbox_session">
             <item>
              <layout class="QHBoxLayout" name="row_overhead">
               <item><widget class="QLabel" name="lbl_overhead"><property name="text"><string>Per-frame overhead (s):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_overhead"><property name="decimals"><number>0</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>120.0</double></property></widget></item>
               <item>
                <spacer name="hsp_overhead">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_overhead"><property name="text"><string>Readout/slew seconds added to every exposure when sizing the transit capture sequence</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_sncadence">
               <item><widget class="QLabel" name="lbl_sn_cadence"><property name="text"><string>SN revisit reminder (days):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QSpinBox" name="spn_sn_cadence"><property name="minimum"><number>1</number></property><property name="maximum"><number>30</number></property></widget></item>
               <item>
                <spacer name="hsp_sncadence">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_sncadence"><property name="text"><string>Nights without a visit after which an active supernova project asks to be revisited</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_eventmag">
               <item><widget class="QLabel" name="lbl_event_mag"><property name="text"><string>Event threshold (mag):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_event_mag"><property name="decimals"><number>1</number></property><property name="minimum"><double>0.2</double></property><property name="maximum"><double>2.0</double></property><property name="singleStep"><double>0.1</double></property></widget></item>
               <item>
                <spacer name="hsp_eventmag">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_eventmag"><property name="text"><string>Brightness jump (in magnitudes) from which a variable/SN project raises the event advisor</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_extremumd">
               <item><widget class="QLabel" name="lbl_extremum_days"><property name="text"><string>Extremum window (days):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QSpinBox" name="spn_extremum_days"><property name="minimum"><number>0</number></property><property name="maximum"><number>30</number></property></widget></item>
               <item>
                <spacer name="hsp_extremumd">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_extremumd"><property name="text"><string>A campaign variable whose maximum/minimum is this many days or less away counts as imminent — it lands in Tonight (window of 0 = today)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_vigils">
               <item><widget class="QLabel" name="lbl_vigils"><property name="text"><string>Variable vigils:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
               <item><widget class="QPlainTextEdit" name="edt_vigils"><property name="minimumSize"><size><width>0</width><height>70</height></size></property><property name="maximumSize"><size><width>16777215</width><height>70</height></size></property></widget></item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_vigils"><property name="text"><string>Standing watch list checked against the latest ZTF magnitude — one star per line: name | rise/drop | baseline mag | threshold (optionally | RA° | Dec°, else resolved via VSX). rise = eruption watch (T CrB), drop = fade watch (R CrB)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_aavso_feed">
               <item><widget class="QCheckBox" name="chk_aavso"><property name="text"><string>AAVSO channel in Tonight</string></property></widget></item>
               <item>
                <spacer name="hsp_aavso_feed">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_aavso"><property name="text"><string>Show the AAVSO editorial channel — forum alerts and active observing campaigns — as Tonight suggestions when the star is up</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_storage">
            <property name="title"><string>Projects folder</string></property>
            <layout class="QVBoxLayout" name="vbox_storage">
             <item>
              <layout class="QHBoxLayout" name="row_proot">
               <item><widget class="QLabel" name="lbl_proot"><property name="text"><string>Projects folder:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_projects_root"/></item>
               <item><widget class="QPushButton" name="btn_projects_browse"><property name="text"><string>Browse…</string></property></widget></item>
               <item><widget class="QPushButton" name="btn_projects_reset"><property name="text"><string>Reset</string></property></widget></item>
               <item>
                <spacer name="hsp_proot">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_storage"><property name="text"><string>Where every project builds its own container folder. Empty uses the app data folder; new projects pick this up, existing ones keep theirs</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>
       <widget class="QScrollArea" name="scr_measurement">
        <property name="widgetResizable"><bool>true</bool></property>
        <widget class="QWidget" name="page_measurement">
         <layout class="QVBoxLayout" name="vbox_measurement">
          <item>
           <widget class="QGroupBox" name="grp_photmethod">
            <property name="title"><string>Photometry</string></property>
            <layout class="QVBoxLayout" name="vbox_photmethod">
             <item><widget class="QCheckBox" name="chk_phot_matched"><property name="text"><string>Measure with the matched filter by default</string></property><property name="toolTip"><string>What a NEW plate starts with. A plate already measured keeps its own recipe, and the switch itself lives in the Photometry tab, beside the measurement, with the measured numbers and the risks in its tooltip</string></property><property name="checked"><bool>true</bool></property></widget></item>
             <item><widget class="QLabel" name="lblH_phot_matched"><property name="text"><string>Weighing every pixel by the star's shape reads about 1.6 times the signal-to-noise of a plain circle and does not underestimate the faint stars. Untick it to have new plates go back to the aperture</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_phot_adv">
            <property name="title"><string>Photometry: advanced</string></property>
            <layout class="QVBoxLayout" name="vbox_phot_adv">
             <item>
              <layout class="QHBoxLayout" name="row_saturate">
               <item><widget class="QLabel" name="lbl_saturate"><property name="text"><string>Saturation ceiling (ADU):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_ccd_saturate"><property name="toolTip"><string>Peak ADU from which a pixel counts as saturated when the FITS header does not say. A saturated star calibrates nothing, so those comps are left out. 0 = trust the header's SATURATE card only</string></property><property name="maximum"><double>1000000.0</double></property><property name="decimals"><number>0</number></property></widget></item>
               <item>
                <spacer name="hsp_saturate">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_saturate"><property name="text"><string>Fallback ceiling for plates whose header is silent; a star whose peak reaches it is dropped, because a saturated star calibrates nothing</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_flat_resid">
               <item><widget class="QLabel" name="lbl_flat_resid"><property name="text"><string>Flat-field residual (mag):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_flat_resid_mag"><property name="toolTip"><string>How much of a magnitude the flat-field residual is worth in the error bar. A good flat leaves a few thousandths of a magnitude; raise it if your flats are rough, lower it if they are excellent</string></property><property name="decimals"><number>3</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>0.2</double></property><property name="singleStep"><double>0.001</double></property></widget></item>
               <item>
                <spacer name="hsp_flat_resid">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_flat_resid"><property name="text"><string>The floor the flat-field residual adds to every error bar: it is what the calibration cannot remove</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_calibration">
            <property name="title"><string>Calibration masters</string></property>
            <layout class="QVBoxLayout" name="vbox_calibration">
             <item><widget class="QLabel" name="lblH_masters"><property name="text"><string>A master is a frame that cancels a pattern the sensor or the optics print on every shot: the bias (the read-out pedestal), the dark (that pedestal plus the thermal current, which grows with the exposure and the temperature) and the flat (the dust shadows and the vignetting). NightScribe picks the right one for each light from the camera, the gain, the sensor temperature, the exposure and the filter, and the editor's Calibration tab says which one it is using. Index here the masters you have already built: the file is linked, never copied or moved.</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_master_add">
               <item><widget class="QLabel" name="lbl_master_kind"><property name="text"><string>Add as:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QComboBox" name="cmb_master_kind"/></item>
               <item><widget class="QPushButton" name="btn_master_add"><property name="text"><string>Add masters…</string></property><property name="toolTip"><string>Pick one or more master FITS files. The kind chosen here applies to all of them: a bias and a flat are different arithmetic, so the library has to know which is which</string></property></widget></item>
               <item>
                <spacer name="hsp_master_add">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_master_kind"><property name="text"><string>The four kinds, in the order of the night: Bias, the shortest exposure with no light at all; Dark, at the same exposure as the lights (it already carries the bias, so it is used alone); Dark of the flats, a dark at the flat's own exposure, which cleans the flat before dividing; and Flat, the illumination and the dust of the train, taken with the filter of the lights.</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item><widget class="QTableWidget" name="tbl_masters"><property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property><property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property><property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property><property name="alternatingRowColors"><bool>true</bool></property><column><property name="text"><string>File</string></property></column><column><property name="text"><string>Kind</string></property></column><column><property name="text"><string>Camera</string></property></column><column><property name="text"><string>Gain</string></property></column><column><property name="text"><string>Temp (°C)</string></property></column><column><property name="text"><string>Exposure (s)</string></property></column><column><property name="text"><string>Filter</string></property></column><column><property name="text"><string>Added</string></property></column></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_master_actions">
               <item><widget class="QPushButton" name="btn_master_remove"><property name="text"><string>Remove from the library</string></property><property name="toolTip"><string>Takes the master out of the index only: the file on disk is never deleted</string></property><property name="enabled"><bool>false</bool></property></widget></item>
               <item>
                <spacer name="hsp_master_actions">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lbl_master_status"><property name="text"><string/></property><property name="wordWrap"><bool>true</bool></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_astro_gate">
            <property name="title"><string>Detection and submission</string></property>
            <layout class="QVBoxLayout" name="vbox_astro_gate">
             <item>
              <layout class="QHBoxLayout" name="row_astro_gate">
               <item><widget class="QLabel" name="lbl_astro_gate"><property name="text"><string>Detection gate (σ):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_astro_gate"><property name="value"><double>3.5</double></property><property name="decimals"><number>1</number></property><property name="minimum"><double>1.0</double></property><property name="maximum"><double>20.0</double></property><property name="singleStep"><double>0.5</double></property></widget></item>
               <item>
                <spacer name="hsp_astro_gate">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_astro_gate"><property name="text"><string>How many times the object's signal must beat the background noise for the run to call it detected. Below it the velocity sweep is not run (a noise maximum is how a false positive is made), but the brightness IS still measured at the ephemeris' position and marked as not to be published without looking at it</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_astro_floor">
               <item><widget class="QLabel" name="lbl_astro_floor"><property name="text"><string>MPC submission floor (SNR):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_astro_floor"><property name="value"><double>10.0</double></property><property name="decimals"><number>1</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>200.0</double></property><property name="singleStep"><double>1.0</double></property></widget></item>
               <item>
                <spacer name="hsp_astro_floor">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_astro_floor"><property name="text"><string>Per observation. The MPC recommends 20 or more and forbids marginal detections, so an observation below this floor does not go into the report and says why. The app ships 10 on purpose: it is a recommendation, and real submissions at about 16 have been accepted. Lowering it further is taking the risk of a false tracklet; a report whose observations all fall below it comes out empty and says so</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_astro_sweep">
            <property name="title"><string>Velocity sweep and cutout</string></property>
            <layout class="QVBoxLayout" name="vbox_astro_sweep">
             <item>
              <layout class="QHBoxLayout" name="row_astro_sweep">
               <item><widget class="QLabel" name="lbl_astro_sweep"><property name="text"><string>Sweep span (%):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_astro_sweep_pct"><property name="value"><double>5.0</double></property><property name="decimals"><number>1</number></property><property name="minimum"><double>0.5</double></property><property name="maximum"><double>50.0</double></property><property name="singleStep"><double>0.5</double></property></widget></item>
               <item><widget class="QLabel" name="lbl_astro_steps"><property name="text"><string>Velocities scored:</string></property></widget></item>
               <item><widget class="QSpinBox" name="spn_astro_steps"><property name="value"><number>25</number></property><property name="minimum"><number>4</number></property><property name="maximum"><number>400</number></property><property name="singleStep"><number>5</number></property></widget></item>
               <item>
                <spacer name="hsp_astro_sweep">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_astro_sweep"><property name="text"><string>How far around the ephemeris' own velocity the run searches, and how many combinations it scores (25 = a 5x5 grid). The ephemeris' prediction is one of the candidates and the sweep is only used when it beats it by more than the grid's own scatter, so a wide grid cannot invent a motion</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_astro_margin">
               <item><widget class="QLabel" name="lbl_astro_margin"><property name="text"><string>Cutout margin (px):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QSpinBox" name="spn_astro_margin"><property name="value"><number>64</number></property><property name="minimum"><number>8</number></property><property name="maximum"><number>1024</number></property><property name="singleStep"><number>8</number></property></widget></item>
               <item>
                <spacer name="hsp_astro_margin">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_astro_margin"><property name="text"><string>Extra pixels around the object's own trail in the cutout the detection and the velocity sweep work on. Bigger is safer and slower; when the ephemeris had to be propagated locally the run widens it by itself</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_astro_check">
            <property name="title"><string>Check against other observers</string></property>
            <layout class="QVBoxLayout" name="vbox_astro_check">
             <item>
              <layout class="QHBoxLayout" name="row_astro_check">
               <item><widget class="QLabel" name="lbl_astro_check"><property name="text"><string>Check every run:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QCheckBox" name="chk_astro_check"><property name="checked"><bool>true</bool></property></widget></item>
               <item><widget class="QLabel" name="lbl_astro_check_sigma"><property name="text"><string>Outlier at (σ):</string></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_astro_check_sigma"><property name="value"><double>3.0</double></property><property name="decimals"><number>1</number></property><property name="minimum"><double>0.5</double></property><property name="maximum"><double>20.0</double></property><property name="singleStep"><double>0.5</double></property></widget></item>
               <item>
                <spacer name="hsp_astro_check">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_astro_check"><property name="text"><string>Compares our measurement with the observations other stations have published (needs Find_Orb, in Integrations) and blocks the report when our point stands out of the cloud. It filters, it does not prove: on a short arc a wrong observation fits just as well</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_astro_check_more">
               <item><widget class="QLabel" name="lbl_astro_check_floor"><property name="text"><string>Residual floor (″):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_astro_check_floor"><property name="value"><double>1.0</double></property><property name="decimals"><number>1</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>60.0</double></property><property name="singleStep"><double>0.5</double></property></widget></item>
               <item><widget class="QLabel" name="lbl_astro_check_window"><property name="text"><string>Window (days):</string></property></widget></item>
               <item><widget class="QSpinBox" name="spn_astro_check_window"><property name="value"><number>30</number></property><property name="minimum"><number>1</number></property><property name="maximum"><number>365</number></property><property name="singleStep"><number>5</number></property></widget></item>
               <item>
                <spacer name="hsp_astro_check_more">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_astro_check_more"><property name="text"><string>A residual below the floor in arcseconds is never an outlier (the other stations' own noise is bigger than that), and only the observations inside the window are compared</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_findorb">
            <property name="title"><string>Find_Orb (orbit check)</string></property>
            <layout class="QVBoxLayout" name="vbox_findorb">
             <item>
              <layout class="QHBoxLayout" name="row_findorb">
               <item><widget class="QLabel" name="lbl_findorb"><property name="text"><string>Find_Orb binary:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_findorb_path"/></item>
               <item><widget class="QPushButton" name="btn_findorb_browse"><property name="text"><string>…</string></property></widget></item>
               <item><widget class="QPushButton" name="btn_findorb_test"><property name="text"><string>Test</string></property></widget></item>
               <item><widget class="QPushButton" name="btn_findorb_install"><property name="text"><string>Install…</string></property><property name="toolTip"><string>Install Find_Orb for me: it looks for micromamba, mamba or conda, creates a private environment with the conda-forge package "findorb" (the precompiled fo plus the DE430t ephemerides) and fills the path. With no package manager it tells you what to install and what to type: the app never downloads one on its own</string></property></widget></item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_findorb"><property name="text"><string>Optional: the NON-interactive Find_Orb ("fo" on Linux/macOS, "fo64.exe" on Windows) checks our measurements against the published ones before the report; the interactive one is refused. An empty path looks for "fo" on PATH. Without it the check is not available, and it says so</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item><widget class="QLabel" name="lblH_findorb_install"><property name="text"><string>Install… first checks whether fo is already on PATH and points the path at it, because that is the common case: the program was installed and the app was never told. If it is not there, the install runs with the package manager it finds, and the environment is private, inside the folder you choose, so nothing of your existing setup is touched</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_astro_work">
            <property name="title"><string>Work</string></property>
            <layout class="QVBoxLayout" name="vbox_astro_work">
             <item>
              <layout class="QHBoxLayout" name="row_astro_threads">
               <item><widget class="QLabel" name="lbl_astro_threads"><property name="text"><string>Threads:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QSpinBox" name="spn_astro_threads"><property name="minimum"><number>0</number></property><property name="maximum"><number>256</number></property><property name="toolTip"><string>0 = automatic</string></property></widget></item>
               <item>
                <spacer name="hsp_astro_threads">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_astro_threads"><property name="text"><string>0 computes it from the cores this process may use and from the memory each task needs; a positive value caps it by hand for a machine that is busy with something else</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_astro_adv">
            <property name="title"><string>Astrometry: advanced</string></property>
            <layout class="QVBoxLayout" name="vbox_astro_adv">
             <item>
              <layout class="QHBoxLayout" name="row_fallback_margin">
               <item><widget class="QLabel" name="lbl_fallback_margin"><property name="text"><string>Fallback margin (px):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QSpinBox" name="spn_astro_fallback_margin"><property name="toolTip"><string>Extra cutout margin used when the ephemeris had to be propagated locally. Two-body and a coarse Earth can put a close object a couple of arcminutes off; the reported position is unaffected</string></property><property name="maximum"><number>4096</number></property><property name="singleStep"><number>16</number></property></widget></item>
               <item>
                <spacer name="hsp_fallback_margin">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_fallback_margin"><property name="text"><string>How much the cutout widens when the object's position had to be computed locally instead of asked of Horizons</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_disagree">
               <item><widget class="QLabel" name="lbl_disagree_arcsec"><property name="text"><string>Agreement floor (″):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_astro_disagree_arcsec"><property name="toolTip"><string>Below this difference in arcseconds the two ways of measuring the position are never called a disagreement: it is smaller than the noise</string></property><property name="decimals"><number>2</number></property><property name="minimum"><double>0.0</double></property><property name="maximum"><double>60.0</double></property><property name="singleStep"><double>0.05</double></property></widget></item>
               <item><widget class="QLabel" name="lbl_disagree_sigma"><property name="text"><string>Agreement (σ):</string></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_astro_disagree_sigma"><property name="toolTip"><string>How many times the combined error the two positions may differ before the run flags them</string></property><property name="decimals"><number>1</number></property><property name="minimum"><double>0.5</double></property><property name="maximum"><double>20.0</double></property><property name="singleStep"><double>0.5</double></property></widget></item>
               <item>
                <spacer name="hsp_disagree">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_disagree"><property name="text"><string>When the stack and the per-frame route place the object further apart than this, the run says so: one of the two is wrong and the plate is not ready to publish</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_solver">
            <property name="title"><string>Plate solver</string></property>
            <layout class="QVBoxLayout" name="vbox_solver">
             <item>
              <layout class="QHBoxLayout" name="row_solver">
               <item><widget class="QLabel" name="lbl_solver"><property name="text"><string>Solver:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QComboBox" name="cmb_solver"/></item>
               <item>
                <spacer name="hsp_solver">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item>
              <layout class="QHBoxLayout" name="row_astap">
               <item><widget class="QLabel" name="lbl_astap"><property name="text"><string>ASTAP binary:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_astap_path"/></item>
               <item><widget class="QPushButton" name="btn_astap_browse"><property name="text"><string>…</string></property></widget></item>
               <item><widget class="QPushButton" name="btn_astap_test"><property name="text"><string>Test</string></property></widget></item>
              </layout>
             </item>
             <item><widget class="QCheckBox" name="chk_solve_save"><property name="text"><string>Save the solved WCS into the FITS header</string></property><property name="toolTip"><string>When on (default), a solved plate is stored solved: the WCS cards are written into the FITS, atomically, so any program sees it. The pixel data is never touched. Turn it off to keep the solution in memory only</string></property></widget></item>
             <item><widget class="QLabel" name="lblH_astap"><property name="text"><string>Optional: solve plates locally with ASTAP. Auto uses ASTAP first and nova.astrometry.net as fallback; an empty path looks for "astap" on PATH</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_exotic">
            <property name="title"><string>EXOTIC (transit reduction)</string></property>
            <layout class="QVBoxLayout" name="vbox_exotic">
             <item>
              <layout class="QHBoxLayout" name="row_exotic_py">
               <item><widget class="QLabel" name="lbl_exotic_py"><property name="text"><string>Python &lt;= 3.10:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_exotic_python"/></item>
               <item><widget class="QPushButton" name="btn_exotic_py_browse"><property name="text"><string>…</string></property></widget></item>
              </layout>
             </item>
             <item>
              <layout class="QHBoxLayout" name="row_exotic_dir">
               <item><widget class="QLabel" name="lbl_exotic_dir"><property name="text"><string>EXOTIC environment (optional):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_exotic_install"/></item>
               <item><widget class="QPushButton" name="btn_exotic_dir_browse"><property name="text"><string>…</string></property></widget></item>
              </layout>
             </item>
             <item>
              <layout class="QHBoxLayout" name="row_exotic_actions">
               <item><widget class="QPushButton" name="btn_exotic_prepare"><property name="text"><string>Prepare environment</string></property><property name="toolTip"><string>Create a private Python 3.10 environment and install EXOTIC in it (needs network the first time; a few minutes)</string></property></widget></item>
               <item><widget class="QPushButton" name="btn_exotic_test"><property name="text"><string>Test</string></property><property name="toolTip"><string>Check that the interpreter can import EXOTIC and report its version</string></property></widget></item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_exotic"><property name="text"><string>Optional. Simplest on Windows: install Python 3.10 from python.org (tick the "py launcher") and run "pip install exotic" in it, then point the field above to that interpreter. "Prepare environment" builds a private environment for you instead (needs network the first time)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>
       <widget class="QScrollArea" name="scr_integrations">
        <property name="widgetResizable"><bool>true</bool></property>
        <widget class="QWidget" name="page_integrations">
         <layout class="QVBoxLayout" name="vbox_integrations">
          <item>
           <widget class="QGroupBox" name="grp_ccdciel">
            <property name="title"><string>CCDciel (JSON-RPC connection)</string></property>
            <layout class="QVBoxLayout" name="vbox_ccdciel">
             <item>
              <layout class="QHBoxLayout" name="row_ccdhost">
               <item><widget class="QLabel" name="lbl_ccdhost"><property name="text"><string>Host:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_ccdciel_host"/></item>
               <item>
                <spacer name="hsp_ccdhost">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_ccdhost"><property name="text"><string>Where CCDciel is running; localhost by default. Control only works while CCDciel is open.</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_ccdport">
               <item><widget class="QLabel" name="lbl_ccdport"><property name="text"><string>Port:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QSpinBox" name="spn_ccdciel_port"><property name="minimum"><number>1</number></property><property name="maximum"><number>65535</number></property><property name="value"><number>3277</number></property></widget></item>
               <item>
                <spacer name="hsp_ccdport">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_ccdport"><property name="text"><string>Junction point on the CCDciel machine. The default (3277) matches the JSON-RPC server.</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_ccdauto">
               <item><widget class="QLabel" name="lbl_ccdauto"><property name="text"><string>Auto-connect on start:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QCheckBox" name="chk_ccdciel_auto"/></item>
               <item>
                <spacer name="hsp_ccdauto">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_ccdauto"><property name="text"><string>Connect to CCDciel as soon as the app starts (off by default)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_apikeys">
            <property name="title"><string>API keys (all optional)</string></property>
            <layout class="QVBoxLayout" name="vbox_misc">
             <item>
              <layout class="QHBoxLayout" name="row_nfkey">
               <item><widget class="QLabel" name="lbl_nfkey"><property name="text"><string>NEOfixer API key:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_neofixer_key"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>
               <item>
                <spacer name="hsp_nfkey">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_nfkey"><property name="text"><string>Optional: report your observing status to NEOfixer</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_astrokey">
               <item><widget class="QLabel" name="lbl_astrokey"><property name="text"><string>Astrometry.net API key:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_astrometry_key"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>
               <item>
                <spacer name="hsp_astrokey">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_astrokey"><property name="text"><string>Optional: blind-solve FITS without WCS in the Blink tab (free key from nova.astrometry.net)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_tnsbot">
               <item><widget class="QLabel" name="lbl_tnsbot"><property name="text"><string>TNS bot name:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_tns_bot"/></item>
               <item>
                <spacer name="hsp_tnsbot">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_tnsbot"><property name="text"><string>Optional: TNS bot credentials to fetch discovery images for transients</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_tnskey">
               <item><widget class="QLabel" name="lbl_tnskey"><property name="text"><string>TNS bot key:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_tns_bot_key"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>
               <item>
                <spacer name="hsp_tnskey">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_tnskey"><property name="text"><string>Optional: TNS bot credentials to fetch discovery images for transients</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_aavso_token">
               <item><widget class="QLabel" name="lbl_aavso_token"><property name="text"><string>AAVSO API token:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_aavso_token"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_aavso_token"><property name="text"><string>Optional; from your AAVSO account. The bright-star vigils (baseline under ~11.5 mag, e.g. T CrB / R CrB) read the community photometry, which requires this token — without it they stay silent</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_ai">
            <property name="title"><string>AI writing and assistant (experimental, optional)</string></property>
            <layout class="QVBoxLayout" name="vbox_ai">
             <item>
              <layout class="QHBoxLayout" name="row_ai_enabled">
               <item><widget class="QCheckBox" name="chk_ai_enabled"><property name="text"><string>Use a language model</string></property></widget></item>
               <item>
                <spacer name="hsp_ai_enabled">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_ai_enabled"><property name="text"><string>Experimental, and off by default: with it off the app writes the post with its own template and nothing leaves your machine</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_ai_long">
               <item><widget class="QCheckBox" name="chk_ai_long_report"><property name="text"><string>Long reports (many more tokens; may cost on paid endpoints)</string></property></widget></item>
               <item>
                <spacer name="hsp_ai_long">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_ai_long"><property name="text"><string>On: the model writes a full article with every project fact and the images, plus the short post and the tweet. A local server costs nothing; a paid endpoint charges per token, so leave it off there unless you want it</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_ai_preset">
               <item><widget class="QLabel" name="lbl_ai_preset"><property name="text"><string>Known endpoint:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QComboBox" name="cmb_ai_preset"/></item>
               <item>
                <spacer name="hsp_ai_preset">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_ai_preset"><property name="text"><string>Fills the address of a common service so you only type the key; any OpenAI-compatible address works, cloud or local</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_ai_base_url">
               <item><widget class="QLabel" name="lbl_ai_base_url"><property name="text"><string>Endpoint address:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_ai_base_url"/></item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_ai_base_url"><property name="text"><string>The address includes its version path; a local server keeps everything on your machine</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_ai_key">
               <item><widget class="QLabel" name="lbl_ai_key"><property name="text"><string>API key:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_ai_api_key"><property name="echoMode"><enum>QLineEdit::Password</enum></property></widget></item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_ai_key"><property name="text"><string>Only for a cloud endpoint; a local server needs none. It is stored in your configuration file and sent only to the address above</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_ai_model">
               <item><widget class="QLabel" name="lbl_ai_model"><property name="text"><string>Model:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QComboBox" name="cmb_ai_model"><property name="editable"><bool>true</bool></property><property name="insertPolicy"><enum>QComboBox::NoInsert</enum></property></widget></item>
               <item><widget class="QPushButton" name="btn_ai_models"><property name="text"><string>List models</string></property><property name="toolTip"><string>Ask the endpoint which models it has. A local server answers with its exact names, so you do not have to type them</string></property></widget></item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_ai_model"><property name="text"><string>The exact name the endpoint expects; the endpoint's own list is the source of truth</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_ai_temp">
               <item><widget class="QLabel" name="lbl_ai_temp"><property name="text"><string>Freedom:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QDoubleSpinBox" name="spn_ai_temp"><property name="decimals"><number>1</number></property><property name="minimum"><double>0.000000000000000</double></property><property name="maximum"><double>2.000000000000000</double></property><property name="singleStep"><double>0.100000000000000</double></property></widget></item>
               <item>
                <spacer name="hsp_ai_temp">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_ai_temp"><property name="text"><string>How freely the model phrases things: near zero is more literal, higher is more varied. It never changes the facts</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_ai_test">
               <item><widget class="QPushButton" name="btn_ai_test"><property name="text"><string>Test connection</string></property></widget></item>
               <item><widget class="QLabel" name="lbl_ai_status"><property name="text"><string/></property><property name="wordWrap"><bool>true</bool></property></widget></item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_ai_test"><property name="text"><string>Asks the endpoint for a one-line reply so you know the address, the key and the model agree; it runs only when you click</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>
       <widget class="QScrollArea" name="scr_interface">
        <property name="widgetResizable"><bool>true</bool></property>
        <widget class="QWidget" name="page_interface">
         <layout class="QVBoxLayout" name="vbox_interface">
          <item>
           <widget class="QGroupBox" name="grp_language">
            <property name="title"><string>Language</string></property>
            <layout class="QVBoxLayout" name="vbox_language">
             <item>
              <layout class="QHBoxLayout" name="row_language">
               <item><widget class="QLabel" name="lbl_language"><property name="text"><string>Interface language:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QComboBox" name="cmb_language"/></item>
               <item>
                <spacer name="hsp_language">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_language"><property name="text"><string>Interface language; applies when the app restarts</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_chartann">
            <property name="title"><string>Charts and annotations</string></property>
            <layout class="QVBoxLayout" name="vbox_chartann">
             <item>
              <layout class="QHBoxLayout" name="row_observer">
               <item><widget class="QLabel" name="lbl_observer"><property name="text"><string>Observer:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_observer"/></item>
               <item>
                <spacer name="hsp_observer">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_observer"><property name="text"><string>Your name as it should read in the chart boxes (Obs); may stay empty</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_measurer">
               <item><widget class="QLabel" name="lbl_measurer"><property name="text"><string>Measurer:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_measurer"/></item>
               <item>
                <spacer name="hsp_measurer">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_measurer"><property name="text"><string>Who measured the plate (Msr); empty means the observer</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_teldesc">
               <item><widget class="QLabel" name="lbl_teldesc"><property name="text"><string>Telescope:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_telescope"><property name="placeholderText"><string>0.43-m f/4.9 reflector</string></property></widget></item>
               <item>
                <spacer name="hsp_teldesc">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_teldesc"><property name="text"><string>Free-text telescope line for the chart boxes (Tel)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_cammodel">
               <item><widget class="QLabel" name="lbl_cammodel"><property name="text"><string>Camera model:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QLineEdit" name="edt_camera_model"/></item>
               <item>
                <spacer name="hsp_cammodel">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_cammodel"><property name="text"><string>Free-text camera line for the chart boxes (Cam)</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_marker_style">
               <item><widget class="QLabel" name="lbl_marker_style"><property name="text"><string>Object marker:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QComboBox" name="cmb_marker_style"/></item>
               <item>
                <spacer name="hsp_marker_style">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_marker_style"><property name="text"><string>How the object is marked on the charts: a ring with ticks (classic) or a full-frame cross with a box</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_annot">
               <item><widget class="QLabel" name="lbl_annot"><property name="text"><string>Object annotation:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QCheckBox" name="chk_annot_visible"><property name="text"><string>Show the circle with the object's name on the stacks</string></property><property name="toolTip"><string>The circle + name the astrometry run writes on each stack (an AIJ ANNOTATE card). Off, the plate opens with the object's cross only; the "A" button in the editor's top bar toggles it at any time</string></property></widget></item>
               <item>
                <spacer name="hsp_annot">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item>
              <layout class="QHBoxLayout" name="row_mark_color">
               <item><widget class="QLabel" name="lbl_mark_color"><property name="text"><string>Object marks:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QComboBox" name="cmb_mark_color"/></item>
               <item>
                <spacer name="hsp_mark_color">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_mark_color"><property name="text"><string>Colour of the object's marks in the editor (the full-frame crosshair, the cross the run measured with and the circle with the name): the object type's own colour (NEO blue, SN red, comet green…), the one the project wears, or one common colour for all of them</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
             <item>
              <layout class="QHBoxLayout" name="row_chart_data">
               <item><widget class="QLabel" name="lbl_chart_data"><property name="text"><string>Plate band:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QCheckBox" name="chk_chart_data"><property name="text"><string>Say what the plate knows (position, magnitude, date, exposure, kit, station, scale, field)</string></property><property name="toolTip"><string>The plate's band, over the image: what the corner boxes used to say, with a colour per datum. The colour says how much to trust it: ink for what this plate's own solution places, dimmed for what is only the catalogue's, and for the magnitude a scale of its own: GREEN clean (error up to 0.05), ORANGE usable but not clean (up to 0.15 or a light caveat), RED not worth reporting without looking, and WHITE for a catalogue value. Off, the band keeps the object's name only</string></property></widget></item>
               <item>
                <spacer name="hsp_chart_data">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item>
              <layout class="QHBoxLayout" name="row_chart_boxes">
               <item><widget class="QLabel" name="lbl_chart_boxes"><property name="text"><string>Other charts:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QCheckBox" name="chk_chart_boxes"><property name="text"><string>Stamp the metadata boxes on the blink and the finder chart</string></property><property name="toolTip"><string>The corner boxes of the OTHER charts (the blink GIF/MP4 and the photometric sequence chart). The plate's own band in the editor is the setting above</string></property></widget></item>
               <item>
                <spacer name="hsp_chart_boxes">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_chart_boxes"><property name="text"><string>Corner boxes with the object, date, position, brightness, observer, equipment and plate scale; on screen and in the exported PNG/GIF/video</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_motion">
            <property name="title"><string>Motion</string></property>
            <layout class="QVBoxLayout" name="vbox_motion">
             <item>
              <layout class="QHBoxLayout" name="row_animations">
               <item><widget class="QLabel" name="lbl_animations"><property name="text"><string>Animated sky on Welcome:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QCheckBox" name="chk_animations"/></item>
               <item>
                <spacer name="hsp_animations">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_animations"><property name="text"><string>On: the Welcome sky breathes (a few stars twinkle) and the screen fades in once. Off: everything stays perfectly still. The Moon is drawn at tonight's real phase either way; applies at once, no restart needed.</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QGroupBox" name="grp_ufe">
            <property name="title"><string>FITS editor</string></property>
            <layout class="QVBoxLayout" name="vbox_ufe">
             <item>
              <layout class="QHBoxLayout" name="row_ufe">
               <item><widget class="QLabel" name="lbl_ufe_icons"><property name="text"><string>Icons-only top bar:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
               <item><widget class="QCheckBox" name="chk_ufe_bar_icons"/></item>
               <item>
                <spacer name="hsp_ufe">
                 <property name="orientation"><enum>Qt::Horizontal</enum></property>
                 <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
                </spacer>
               </item>
              </layout>
             </item>
             <item><widget class="QLabel" name="lblH_ufe"><property name="text"><string>The editor's action buttons show compact glyphs instead of their labels (Solve keeps its text); off restores them. It applies at once, no restart needed. The unified editor is the only door to the FITS work: the classic dialogs retired once it became the default, so there is nothing to switch back to.</string></property><property name="wordWrap"><bool>true</bool></property><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property></widget></item>
            </layout>
           </widget>
          </item>
         </layout>
        </widget>
       </widget>
      </widget>
     </item>
    </layout>
   </item>
   <item><widget class="QDialogButtonBox" name="buttonBox"><property name="standardButtons"><set>QDialogButtonBox::Save|QDialogButtonBox::Cancel</set></property></widget></item>
