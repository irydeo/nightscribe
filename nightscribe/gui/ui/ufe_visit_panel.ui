<?xml version="1.0" encoding="UTF-8"?>
<!--
  The visit strip of the editor's left panel (ADR-048 follow-up): the
  frame navigator and the frame previews. Loaded by gui/ufe_dialog.py
  through gui/ui_loader.py; the class tag is UfeDialog so the i18n context
  carries over. The count, the file name and the status line are data, set in
  code. The series group used to land here in a ph_series placeholder, and
  the EXOTIC reduction block lived here too: since ADR-044 rev
  (2026-10-06) both are in the series window (Tools ▾ → Series), which is
  what a transit reduction belongs to.
-->
<ui version="4.0">
 <class>UfeDialog</class>
 <widget class="QWidget" name="UfeVisitPanel">
  <layout class="QVBoxLayout" name="vbox_visit">
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
   <item>
    <widget class="QLabel" name="lbl_frame">
     <property name="toolTip"><string>The frame open in the editor is the reference: the target and the comparison stars are measured in its pixels</string></property>
     <property name="text"><string>Frame</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="row_frame_nav">
     <item><widget class="QPushButton" name="btn_frame_prev"><property name="text"><string>‹</string></property><property name="toolTip"><string>Previous frame (PageUp)</string></property></widget></item>
     <item><widget class="QPushButton" name="btn_frame_next"><property name="text"><string>›</string></property><property name="toolTip"><string>Next frame (PageDown)</string></property></widget></item>
     <item><widget class="QPushButton" name="btn_frame_first"><property name="text"><string>First</string></property><property name="toolTip"><string>Back to the first frame of the visit, the reference by default</string></property></widget></item>
     <item><spacer name="hsp_frame"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>10</width><height>20</height></size></property></spacer></item>
    </layout>
   </item>
   <item><widget class="QLabel" name="lbl_frame_file"><property name="text"><string/></property><property name="wordWrap"><bool>true</bool></property></widget></item>
   <item>
    <layout class="QHBoxLayout" name="row_frames_head">
     <item><widget class="QLabel" name="lbl_frames_count"><property name="text"><string>Frames</string></property><property name="toolTip"><string>The frames of this visit, one preview each. The list fills as they are read (a small sample of each, not the whole frame). Right-click a preview to take it out of the visit or move it aside</string></property></widget></item>
     <item><spacer name="hsp_frames"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>10</width><height>20</height></size></property></spacer></item>
     <item><widget class="QCheckBox" name="chk_frames_problems"><property name="text"><string>Only problems</string></property><property name="toolTip"><string>Show only the frames with something to look at: the ones that cannot be read, the ones without an astrometric solution and the ones the last run could not register. It is the fast way through a visit of hundreds of frames</string></property></widget></item>
    </layout>
   </item>
   <item><widget class="QWidget" name="ph_frames"/></item>
   <item><spacer name="vsp_visit"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property></spacer></item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
