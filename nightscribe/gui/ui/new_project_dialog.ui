     <item row="3" column="1"><widget class="QLineEdit" name="edt_ra"/></item>
     <item row="4" column="0"><widget class="QLabel" name="lbl_dec"><property name="text"><string>Dec (deg):</string></property></widget></item>
     <item row="4" column="1"><widget class="QLineEdit" name="edt_dec"/></item>
     <item row="5" column="0"><widget class="QLabel" name="lbl_mag"><property name="text"><string>Mag (approx):</string></property></widget></item>
     <item row="5" column="1"><widget class="QLineEdit" name="edt_mag"/></item>
